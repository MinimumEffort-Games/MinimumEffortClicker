<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Linux native adapters: GNOME Shell helper and KWin (D-Bus, Wayland), evdev and logind. No WPF or Windows APIs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MinimumEffortClicker.Engine/MinimumEffortClicker.Engine.csproj" />
    <PackageReference Include="Tmds.DBus.Protocol" />
    <InternalsVisibleTo Include="Linux.Tests" />
    <EmbeddedResource Include="Kde/kwin-helper.js" LogicalName="MinimumEffortClicker.Linux.Kde.kwin-helper.js" />
  </ItemGroup>
</Project>
