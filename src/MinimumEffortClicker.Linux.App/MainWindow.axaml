<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:linux="using:MinimumEffortClicker.Linux"
        xmlns:core="using:MinimumEffortClicker.Core"
        xmlns:local="using:MinimumEffortClicker.App"
        x:Class="MinimumEffortClicker.App.MainWindow"
        Title="Minimum Effort Clicker" Icon="/Assets/App.png"
        Width="1180" Height="740" MinWidth="900" MinHeight="600"
        UseLayoutRounding="True" Closing="Window_Closing">
    <Window.Styles>
        <Style Selector="TextBlock.optional">
            <Setter Property="IsVisible" Value="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*">
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal">
                    <ListBox x:Name="Navigation" Classes="navigation" SelectedIndex="0" Background="Transparent" BorderThickness="0" SelectionChanged="Navigation_Changed" AutomationProperties.Name="Navigation tabs" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBoxItem Content="Actions" Tag="0" /><ListBoxItem Content="Toggles" Tag="4" /><ListBoxItem Content="Controller to Key" Tag="7" /><ListBoxItem Content="Screenshot" Tag="6" /><ListBoxItem Content="Settings" Tag="3" />
                    </ListBox>
                    <Button Click="BrandWebsite_Click" ToolTip.Tip="Minimum Effort website" AutomationProperties.Name="Minimum Effort website" Background="Transparent" BorderThickness="0" Margin="16,0,0,0" Padding="4">
                        <Border Width="110" Height="34" Background="{DynamicResource TextPrimary}">
                            <Border.OpacityMask><ImageBrush Source="/Assets/Logo.png" SourceRect="0%,24%,100%,42%" Stretch="Uniform" /></Border.OpacityMask>
                        </Border>
                    </Button>
                    <Button Content="Help" Click="Help_Click" Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Help" />
                </StackPanel>
                <ToggleButton Grid.Column="1" x:Name="OverlayBox" Classes="choice" Content="Show overlay" IsChecked="True" VerticalAlignment="Center" IsCheckedChanged="Overlay_Changed" Margin="16,0,0,0" ToolTip.Tip="The small status window that shows what the clicker is doing." />
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="16,12,16,12" RowDefinitions="*,Auto">
            <Panel x:Name="Pages">
                <!-- Page 0: Actions -->
                <Grid x:Name="QuickPage" ColumnDefinitions="*,25,*" RowDefinitions="Auto,Auto,*">
                    <Border Grid.Column="1" Grid.RowSpan="3" Width="1" Background="{DynamicResource Border}" HorizontalAlignment="Center" />
                    <TextBlock Text="Start/Stop" Classes="heading" />
                    <TextBlock Grid.Column="2" Text="Action List" Classes="heading" />
                    <WrapPanel Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Bottom">
                        <Button x:Name="RunButton" Content="Start F8" Click="Run_Click" Classes="green" MinWidth="100" Margin="0,0,8,0" AutomationProperties.Name="Start Actions" />
                        <Button x:Name="PausePlaybackButton" Content="Pause" Click="PausePlayback_Click" Classes="blue" Margin="0" AutomationProperties.Name="Pause playback" />
                        <UniformGrid Rows="2" Margin="12,0,0,0">
                            <ToggleButton x:Name="LoopBox" Classes="choice stacked" Content="Loop" IsCheckedChanged="Loop_Changed" Margin="0,0,0,2" />
                            <ToggleButton IsCheckedChanged="ActionsChoice_Changed" x:Name="MinimizeOnStartBox" Classes="choice stacked" Content="Minimize on Start" IsChecked="True" Margin="0,2,0,0" ToolTip.Tip="Ticked: Start minimises the clicker when the Click target is Desktop, and brings it back when the run ends. Unticked: the clicker stays up. With a window target, that window still comes to the front." />
                        </UniformGrid>
                        <Button x:Name="CleanupButton" Content="Release stuck input" Click="Cleanup_Click" IsVisible="False" Classes="red" HorizontalAlignment="Left" ToolTip.Tip="Release physical buttons and keys first. This retries only inputs owned by ME Clicker and never starts playback." />
                    </WrapPanel>
                    <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock x:Name="QuickRecordStatus" Classes="secondary optional" FontSize="12" Margin="0,0,0,4" />
                        <WrapPanel>
                            <Button x:Name="QuickRecordButton" Content="F10 Record/Stop" Click="QuickRecord_Click" Classes="red" Margin="0,0,12,0" Padding="6,7" MinWidth="120" />
                            <UniformGrid Rows="2">
                                <ToggleButton IsCheckedChanged="ActionsChoice_Changed" x:Name="RecordDelaysBox" Classes="choice stacked" Content="Record pauses" IsChecked="True" Margin="0,0,0,2" ToolTip.Tip="Keep the time between inputs as editable Pause actions." />
                                <ToggleButton IsCheckedChanged="ActionsChoice_Changed" x:Name="MinimizeOnRecordBox" Classes="choice stacked" Content="Minimize on record" IsChecked="True" Margin="0,2,0,0" ToolTip.Tip="Ticked: the Record button minimises the clicker (F10 too when the Click target is Desktop). Unticked: the clicker stays where it is and just records." />
                            </UniformGrid>
                        </WrapPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" x:Name="ActionsScroll" Padding="0,0,16,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="FailureDetailLabel" TextWrapping="Wrap" IsVisible="False" />
                            <TextBlock x:Name="PickTargetHeading" Text="Pick a target" Classes="heading" />
                            <StackPanel x:Name="QuickFields">
                                <Border x:Name="TargetCard" Classes="card" BorderThickness="2">
                                    <StackPanel>
                                        <TextBlock Text="Click target" FontWeight="SemiBold" />
                                        <ComboBox x:Name="TargetLabel" DropDownOpened="ClickTargets_Opened" SelectionChanged="ClickTarget_Changed" AutomationProperties.Name="Click target" ToolTip.Tip="Desktop uses screen coordinates. Open this list to refresh available windows." DisplayMemberBinding="{Binding Title, x:DataType=linux:TargetWindow}" />
                                        <TextBlock Text="If no app is selected, physical desktop coordinates are used." Classes="secondary" FontSize="12" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Create an action" Classes="heading" />
                                <Border x:Name="CreateActionCard" Classes="card" BorderBrush="{DynamicResource ActionBorder}" BorderThickness="2">
                                    <StackPanel>
                                        <TextBlock Text="Action" FontWeight="SemiBold" />
                                        <ListBox x:Name="ModeBox" Classes="choice" SelectedIndex="-1" SelectionChanged="ActionType_Changed" AutomationProperties.Name="Action" Margin="0,4,0,0">
                                            <ListBoxItem ToolTip.Tip="Click" AutomationProperties.Name="Click"><Image Source="/Assets/Ui/actions/click.png" Width="34" Height="34" RenderOptions.BitmapInterpolationMode="HighQuality" /></ListBoxItem>
                                            <ListBoxItem ToolTip.Tip="Key Press" AutomationProperties.Name="Key Press"><Image Source="/Assets/Ui/actions/key-press.png" Width="34" Height="34" RenderOptions.BitmapInterpolationMode="HighQuality" /></ListBoxItem>
                                            <ListBoxItem ToolTip.Tip="Pause" AutomationProperties.Name="Pause"><Image Source="/Assets/Ui/actions/pause.png" Width="34" Height="34" RenderOptions.BitmapInterpolationMode="HighQuality" /></ListBoxItem>
                                            <ListBoxItem ToolTip.Tip="Wait Until" AutomationProperties.Name="Wait Until"><Image Source="/Assets/Ui/actions/wait-until.png" Width="34" Height="34" RenderOptions.BitmapInterpolationMode="HighQuality" /></ListBoxItem>
                                            <ListBoxItem ToolTip.Tip="Take fullscreen screenshot" AutomationProperties.Name="Take fullscreen screenshot"><Image Source="/Assets/Ui/actions/fullscreen-screenshot.png" Width="34" Height="34" RenderOptions.BitmapInterpolationMode="HighQuality" /></ListBoxItem>
                                            <ListBoxItem ToolTip.Tip="Scroll" AutomationProperties.Name="Scroll"><Image Source="/Assets/Ui/actions/scroll.png" Width="34" Height="34" RenderOptions.BitmapInterpolationMode="HighQuality" /></ListBoxItem>
                                        </ListBox>
                                        <TextBlock x:Name="ActionHint" Text="Choose an action to see its settings." Classes="secondary" Margin="0,4,0,8" />
                                        <StackPanel x:Name="ActionFields" IsVisible="False">
                                            <StackPanel x:Name="MouseFields" IsVisible="False">
                                                <TextBlock Text="Mouse Button" FontWeight="SemiBold" />
                                                <local:MouseButtonPicker x:Name="ButtonPicker" Height="170" HorizontalAlignment="Left" Margin="0,4,0,8" />
                                                <TextBlock Text="Click Type" FontWeight="SemiBold" />
                                                <ListBox x:Name="ClickKindBox" Classes="choice" SelectedIndex="0" SelectionChanged="ClickKind_Changed" AutomationProperties.Name="Click type" Margin="0,4,0,8">
                                                    <ListBoxItem Content="Single Click" Padding="10,6" /><ListBoxItem Content="Double Click" Padding="10,6" /><ListBoxItem Content="Hold" Padding="10,6" ToolTip.Tip="Presses, keeps the button down for the hold duration, then lets go." />
                                                </ListBox>
                                            </StackPanel>
                                            <StackPanel x:Name="ScrollFields" IsVisible="False">
                                                <TextBlock Text="Direction" FontWeight="SemiBold" />
                                                <!-- Item order is the direction's number (Up, Down, Left, Right); the grid places them like arrow keys. -->
                                                <ListBox x:Name="ScrollDirectionBox" Classes="choice" SelectedIndex="1" AutomationProperties.Name="Scroll direction" Margin="0,4,0,8" HorizontalAlignment="Left">
                                                    <ListBox.ItemsPanel><ItemsPanelTemplate><Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                                    <ListBoxItem Grid.Column="1" Padding="2" Margin="2" ToolTip.Tip="Up" AutomationProperties.Name="Up"><Image Source="/Assets/Ui/keys/up.png" Width="34" Height="34" RenderOptions.BitmapInterpolationMode="HighQuality" /></ListBoxItem>
                                                    <ListBoxItem Grid.Column="1" Grid.Row="1" Padding="2" Margin="2" ToolTip.Tip="Down" AutomationProperties.Name="Down"><Image Source="/Assets/Ui/keys/down.png" Width="34" Height="34" RenderOptions.BitmapInterpolationMode="HighQuality" /></ListBoxItem>
                                                    <ListBoxItem Grid.Row="1" Padding="2" Margin="2" ToolTip.Tip="Left" AutomationProperties.Name="Left"><Image Source="/Assets/Ui/keys/left.png" Width="34" Height="34" RenderOptions.BitmapInterpolationMode="HighQuality" /></ListBoxItem>
                                                    <ListBoxItem Grid.Column="2" Grid.Row="1" Padding="2" Margin="2" ToolTip.Tip="Right" AutomationProperties.Name="Right"><Image Source="/Assets/Ui/keys/right.png" Width="34" Height="34" RenderOptions.BitmapInterpolationMode="HighQuality" /></ListBoxItem>
                                                </ListBox>
                                                <TextBlock Text="Notches (1–100)" />
                                                <TextBox x:Name="ScrollNotchesBox" local:Spin.Step="1" local:Spin.Minimum="1" local:Spin.Maximum="100" Text="3" AutomationProperties.Name="Scroll notches" ToolTip.Tip="One notch is one click of the mouse wheel." />
                                                <TextBlock Text="Time between notches (ms)" />
                                                <TextBox x:Name="ScrollGapBox" local:Spin.Step="10" local:Spin.Minimum="0" local:Spin.Maximum="60000" Text="30" AutomationProperties.Name="Time between scroll notches" />
                                            </StackPanel>
                                            <StackPanel x:Name="LocationFields" IsVisible="False">
                                                <TextBlock x:Name="ClickLocationHeader" Text="Click Location" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBlock x:Name="ScrollLocationHeader" Text="Scroll Location" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <WrapPanel>
                                                    <Button x:Name="CursorLocationButton" Margin="0,0,6,0" Content="Cursor location" Click="CursorLocation_Click" Classes="chosen" />
                                                    <Button x:Name="SetLocationButton" Content="Set Location…" Click="PickQuickPoint_Click" />
                                                </WrapPanel>
                                                <WrapPanel Margin="0,6,0,0">
                                                    <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <TextBox x:Name="QuickXBox" Width="100" local:Spin.Step="1" local:Spin.Minimum="-100000" local:Spin.Maximum="100000" VerticalContentAlignment="Center" AutomationProperties.Name="Click X coordinate" ToolTip.Tip="Desktop pixels, or pixels from the selected window's top-left client corner." />
                                                    <TextBlock Text="Y" VerticalAlignment="Center" Margin="4,0,4,0" />
                                                    <TextBox x:Name="QuickYBox" Width="100" local:Spin.Step="1" local:Spin.Minimum="-100000" local:Spin.Maximum="100000" VerticalContentAlignment="Center" AutomationProperties.Name="Click Y coordinate" />
                                                    <Button x:Name="PingLocationButton" Width="100" Height="{Binding #QuickXBox.Bounds.Height}" MinHeight="0" Padding="4,0" Margin="8,4,0,8" VerticalAlignment="Top" Content="Ping location" Click="PingLocation_Click" />
                                                </WrapPanel>
                                            </StackPanel>
                                            <StackPanel x:Name="MotionFields" IsVisible="False">
                                                <ToggleButton x:Name="VaryPositionBox" Classes="choice" Content="Randomize click location offset" HorizontalAlignment="Left" Margin="0,6,0,6" />
                                                <TextBlock Text="Maximum offset (pixels, 0–25)" />
                                                <TextBox x:Name="PositionOffsetBox" local:Spin.Step="1" local:Spin.Minimum="0" local:Spin.Maximum="25" Text="3" AutomationProperties.Name="Click position variation" />
                                            </StackPanel>
                                            <StackPanel x:Name="KeyFields" IsVisible="False">
                                                <TextBlock Text="Key" />
                                                <WrapPanel Margin="0,4,0,8">
                                                    <Button x:Name="KeyBox" Click="ChooseKey_Click" Padding="6,3" Margin="0,0,8,0" ToolTip.Tip="Choose the key on a keyboard." AutomationProperties.Name="Key" />
                                                </WrapPanel>
                                                <WrapPanel Margin="0,0,0,8">
                                                    <ToggleButton x:Name="CtrlBox" Classes="choice keycap" ToolTip.Tip="Ctrl: held with the key" AutomationProperties.Name="Ctrl"><Image Source="/Assets/Ui/keys/left-ctrl.png" Width="36" Height="36" RenderOptions.BitmapInterpolationMode="HighQuality" /></ToggleButton>
                                                    <ToggleButton x:Name="ShiftBox" Classes="choice keycap" ToolTip.Tip="Shift: held with the key" AutomationProperties.Name="Shift"><Image Source="/Assets/Ui/keys/left-shift.png" Width="36" Height="36" RenderOptions.BitmapInterpolationMode="HighQuality" /></ToggleButton>
                                                    <ToggleButton x:Name="AltBox" Classes="choice keycap" ToolTip.Tip="Alt: held with the key" AutomationProperties.Name="Alt"><Image Source="/Assets/Ui/keys/left-alt.png" Width="36" Height="36" RenderOptions.BitmapInterpolationMode="HighQuality" /></ToggleButton>
                                                </WrapPanel>
                                            </StackPanel>
                                            <StackPanel x:Name="PressFields" IsVisible="False"><TextBlock x:Name="PressLabel" Text="Press duration (ms)" /><TextBox x:Name="PressBox" local:Spin.Step="10" local:Spin.Minimum="0" local:Spin.Maximum="3600000" Text="20" AutomationProperties.Name="Press duration in milliseconds" /></StackPanel>
                                            <StackPanel x:Name="DoubleFields" IsVisible="False"><TextBlock Text="Gap between the two clicks (ms)" /><TextBox x:Name="DoubleGapBox" local:Spin.Step="10" local:Spin.Minimum="0" local:Spin.Maximum="60000" Text="80" AutomationProperties.Name="Double click gap" /></StackPanel>
                                            <StackPanel x:Name="AfterFields" IsVisible="False"><TextBlock x:Name="AfterLabel" Text="Pause after this action (ms)" /><TextBox x:Name="AfterBox" local:Spin.Step="10" local:Spin.Minimum="0" local:Spin.Maximum="3600000" Text="20" AutomationProperties.Name="Pause after action" /></StackPanel>
                                            <StackPanel x:Name="ScreenshotActionFields" IsVisible="False">
                                                <TextBlock Text="Pause after saving (ms)" />
                                                <TextBox x:Name="ScreenshotPauseBox" local:Spin.Step="100" local:Spin.Minimum="1000" local:Spin.Maximum="3600000" Text="1000" AutomationProperties.Name="Pause after saving screenshot" />
                                                <TextBlock Text="Minimum 1,000 ms. Each image finishes saving before this pause begins. Uses the folder and clipboard option in Screenshot." Classes="secondary" />
                                            </StackPanel>
                                            <StackPanel x:Name="PauseFields" IsVisible="False">
                                                <TextBlock Text="Pause for" />
                                                <Grid ColumnDefinitions="*,*">
                                                    <TextBox x:Name="PauseDurationBox" local:Spin.Step="1" local:Spin.Minimum="0" local:Spin.Maximum="3600000" Text="1" AutomationProperties.Name="Pause duration" />
                                                    <ListBox Grid.Column="1" x:Name="PauseUnitBox" Classes="choice fill" SelectedIndex="1" Height="{Binding #PauseDurationBox.Bounds.Height}" Margin="8,4,-4,8" AutomationProperties.Name="Pause unit">
                                                        <ListBoxItem Content="ms" ToolTip.Tip="Milliseconds" /><ListBoxItem Content="Seconds" />
                                                    </ListBox>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel x:Name="ConditionFields" IsVisible="False">
                                                <TextBlock Text="Wait until" FontWeight="SemiBold" />
                                                <ListBox x:Name="ConditionKindBox" Classes="choice" SelectedIndex="0" SelectionChanged="ConditionKind_Changed" AutomationProperties.Name="Wait until" Margin="0,4,0,8">
                                                    <ListBoxItem Content="A Colour appears" Padding="10,6" /><ListBoxItem Content="A Colour disappears" Padding="10,6" />
                                                </ListBox>
                                                <TextBlock Text="Area" FontWeight="SemiBold" />
                                                <WrapPanel Margin="0,4,0,0">
                                                    <Button x:Name="SelectAreaButton" Classes="needs-choice" Content="Select area… (drag on a snapshot)" Click="SelectConditionArea_Click" ToolTip.Tip="Takes a picture of the Click target (or the monitors on Desktop) and lets you drag the area to watch. The colour is taken from its top-left pixel." AutomationProperties.Name="Select area" />
                                                    <Button x:Name="PingScanAreaButton" IsEnabled="False" Content="Ping scan area" Click="PingScanArea_Click" ToolTip.Tip="Outlines the area this wait watches on the target, three times." AutomationProperties.Name="Ping scan area" />
                                                </WrapPanel>
                                                <TextBlock Text="RGB colour · six hexadecimal digits" Margin="0,6,0,0" />
                                                <TextBox x:Name="ConditionRgbBox" MaxLength="7" TextChanged="ConditionField_Changed" AutomationProperties.Name="RGB colour" />
                                                <Button x:Name="EyedropperButton" Content="Eyedropper · pick colour…" Margin="0,6,0,6" HorizontalAlignment="Left" Click="ConditionEyedropper_Click" ToolTip.Tip="Click one pixel on a picture of the target to take its colour. The area is kept." AutomationProperties.Name="Eyedropper pick colour" />
                                                <TextBlock Text="Colour Preview" FontWeight="SemiBold" />
                                                <Border x:Name="ConditionColourPreview" MinHeight="34" Margin="0,4,0,6" Padding="8,5" BorderThickness="1" BorderBrush="{DynamicResource ListBorder}">
                                                    <TextBlock x:Name="ConditionLabel" Text="Select the area to scan and what to look for." TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel x:Name="ComplexFields" IsVisible="False">
                                                <TextBlock Text="Recorded inputs — timing in milliseconds" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="Each row is one held input. Offset is when it starts within this action." Classes="secondary" />
                                                <DataGrid x:Name="QuickChildrenGrid" AutoGenerateColumns="False" CanUserReorderColumns="False" MinHeight="120" MaxHeight="220" HeadersVisibility="Column" x:CompileBindings="False">
                                                    <DataGrid.Columns>
                                                        <DataGridTemplateColumn Header="Input" Width="120">
                                                            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Input}" VerticalAlignment="Center" Margin="6,0" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                            <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Input}" Margin="0" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="70" />
                                                        <DataGridTextColumn Header="Hold" Binding="{Binding Duration}" Width="70" />
                                                        <DataGridTextColumn Header="X" Binding="{Binding X}" Width="60" />
                                                        <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="60" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <TextBlock Text="Total action duration (ms)" />
                                                <TextBox x:Name="ComplexDurationBox" local:Spin.Step="10" local:Spin.Minimum="0" local:Spin.Maximum="3600000" AutomationProperties.Name="Total action duration" />
                                            </StackPanel>
                                            <StackPanel Margin="0,8,0,0">
                                                <StackPanel x:Name="RandomFields" IsVisible="False">
                                                    <ToggleButton x:Name="RandomTimingBox" Classes="choice" HorizontalAlignment="Left" Margin="0,0,0,6" Content="Randomize press and pause timing" ToolTip.Tip="Choose a fresh duration between each minimum and maximum on every execution." IsCheckedChanged="TimingOptions_Changed" />
                                                    <StackPanel x:Name="RandomRanges" IsVisible="False">
                                                        <TextBlock Text="Use the values above as minimums." Classes="secondary" />
                                                        <StackPanel x:Name="MaximumPressFields"><TextBlock Text="Maximum press duration (ms)" /><TextBox x:Name="MaxPressBox" local:Spin.Step="10" local:Spin.Minimum="0" local:Spin.Maximum="3600000" Text="40" AutomationProperties.Name="Maximum press duration" /></StackPanel>
                                                        <TextBlock x:Name="MaxAfterLabel" Text="Maximum pause after (ms)" /><TextBox x:Name="MaxAfterBox" local:Spin.Step="10" local:Spin.Minimum="0" local:Spin.Maximum="3600000" Text="80" AutomationProperties.Name="Maximum pause or interval" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Text="Name (optional)" />
                                                <TextBox x:Name="ActionNameBox" MaxLength="100" AutomationProperties.Name="Action name" />
                                                <StackPanel x:Name="ConditionAdvancedFields" IsVisible="False">
                                                    <Expander Header="Advanced: coordinates, scan speed and matching" Margin="0,8,0,8" HorizontalAlignment="Stretch">
                                                        <StackPanel Margin="0,4,0,0">
                                                            <Grid ColumnDefinitions="*,8,*">
                                                                <StackPanel><TextBlock Text="X" /><TextBox x:Name="ConditionXBox" local:Spin.Step="1" local:Spin.Minimum="-100000" local:Spin.Maximum="100000" TextChanged="ConditionField_Changed" AutomationProperties.Name="Area X" /></StackPanel>
                                                                <StackPanel Grid.Column="2"><TextBlock Text="Y" /><TextBox x:Name="ConditionYBox" local:Spin.Step="1" local:Spin.Minimum="-100000" local:Spin.Maximum="100000" TextChanged="ConditionField_Changed" AutomationProperties.Name="Area Y" /></StackPanel>
                                                            </Grid>
                                                            <Grid ColumnDefinitions="*,8,*">
                                                                <StackPanel><TextBlock Text="Width · 1–256 pixels" TextWrapping="Wrap" /><TextBox x:Name="ConditionWidthBox" local:Spin.Step="1" local:Spin.Minimum="1" local:Spin.Maximum="256" TextChanged="ConditionField_Changed" AutomationProperties.Name="Area width" /></StackPanel>
                                                                <StackPanel Grid.Column="2"><TextBlock Text="Height · 1–256 pixels" TextWrapping="Wrap" /><TextBox x:Name="ConditionHeightBox" local:Spin.Step="1" local:Spin.Minimum="1" local:Spin.Maximum="256" TextChanged="ConditionField_Changed" AutomationProperties.Name="Area height" /></StackPanel>
                                                            </Grid>
                                                            <TextBlock Text="Per-channel tolerance · 0–255" /><TextBox x:Name="ConditionToleranceBox" local:Spin.Step="1" local:Spin.Minimum="0" local:Spin.Maximum="255" Text="8" TextChanged="ConditionField_Changed" AutomationProperties.Name="Per-channel tolerance" />
                                                            <TextBlock Text="Scan interval · milliseconds (100–5,000)" /><TextBox x:Name="QuickScanIntervalBox" local:Spin.Step="10" local:Spin.Minimum="100" local:Spin.Maximum="5000" Text="500" TextChanged="ConditionField_Changed" AutomationProperties.Name="Scan interval in milliseconds" />
                                                            <TextBlock Text="Default: 500 ms (twice a second). A smaller area uses less processing." Classes="secondary" TextWrapping="Wrap" />
                                                            <TextBlock Text="Consecutive fresh matching samples · 1–10" /><TextBox x:Name="ConditionStableBox" local:Spin.Step="1" local:Spin.Minimum="1" local:Spin.Maximum="10" Text="1" TextChanged="ConditionField_Changed" AutomationProperties.Name="Consecutive matching samples" />
                                                        </StackPanel>
                                                    </Expander>
                                                    <TextBlock Text="While this wait runs and the Click target goes behind another window, the wait pauses. It carries on by itself once the window is back in front." Classes="secondary" TextWrapping="Wrap" Margin="0,0,0,8" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <WrapPanel x:Name="QuickEditorTools" Margin="0,4,0,12">
                                <Button x:Name="AddActionButton" Content="Add Action" Click="AddAction_Click" IsEnabled="False" ToolTip.ShowOnDisabled="True" Classes="blue" />
                                <Button Content="Clear editor" Click="NewAction_Click" ToolTip.Tip="Clear the settings to create another action. The Action List is kept." />
                            </WrapPanel>
                            <TextBlock x:Name="TestResultLabel" Classes="secondary optional" Margin="0,0,0,5" />
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="ActionListScroll" Grid.Column="2" Grid.Row="2" Padding="0,0,16,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <!-- At least as tall as the visible area, so the Action List (the star row) takes the room a tall window leaves. -->
                        <Grid MinHeight="{Binding #ActionListScroll.Viewport.Height}" RowDefinitions="Auto,*,Auto,Auto,Auto">
                            <Grid MinHeight="{Binding #PickTargetHeading.Bounds.Height}" Margin="0,0,0,8">
                                <Button x:Name="TestSelectedButton" Content="Test Selected Action" Click="TestSelected_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="12,5" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="Test selected action" />
                            </Grid>
                            <Border x:Name="ActionListCard" Grid.Row="1" Classes="card" BorderBrush="{DynamicResource ListBorder}" BorderThickness="2" Margin="0,0,0,12">
                                <Grid RowDefinitions="*,Auto">
                                    <local:FillHeightPanel MinHeight="240">
                                    <ListBox x:Name="QuickActionList" SelectionChanged="QuickSelection_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Action List" x:CompileBindings="False">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Background}" CornerRadius="3">
                                                    <Grid>
                                                    <Border Background="{DynamicResource StopFill}" Opacity="0.45" CornerRadius="3" IsVisible="{Binding Reselect}" IsHitTestVisible="False" />
                                                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="6,4">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <WrapPanel>
                                                                <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                <Border Background="{DynamicResource StopFill}" BorderBrush="{DynamicResource StopBorder}" BorderThickness="1" CornerRadius="3" Padding="5,0" Margin="6,1,0,1" IsVisible="{Binding Reselect}" ToolTip.Tip="This area was picked for another Click target. Select the row, then Select area again.">
                                                                    <TextBlock Text="Reselect Area" Foreground="{DynamicResource ColourButtonText}" FontWeight="SemiBold" FontSize="12" />
                                                                </Border>
                                                            </WrapPanel>
                                                            <TextBlock Text="{Binding Detail}" Foreground="{Binding Foreground}" FontSize="12" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Image Grid.Column="1" Source="{Binding Device}" Width="64" Height="{Binding #RowControls.Bounds.Height}" Margin="10,0,0,0" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" VerticalAlignment="Center" />
                                                        <StackPanel x:Name="RowControls" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <ToggleButton Classes="choice active" IsChecked="{Binding Step.Enabled, Mode=OneWay}" Click="QuickActive_Click" ToolTip.Tip="Inactive actions stay in the list and are skipped." AutomationProperties.Name="Active" />
                                                            <ListBox Classes="choice repeat" SelectedIndex="{Binding RepeatIndex, Mode=OneWay}" SelectionChanged="QuickRepeat_Changed" AutomationProperties.Name="Repeat this action" Margin="0,4,0,0" ToolTip.Tip="With Loop on: Repeating actions run in every loop. Once actions run only in the first loop and are skipped in every loop after it. Without Loop, every action runs once.">
                                                                <ListBoxItem AutomationProperties.Name="Repeating"><PathIcon Data="{StaticResource IconRepeat}" Width="14" Height="14" /></ListBoxItem>
                                                                <ListBoxItem AutomationProperties.Name="Once"><Panel Width="18" Height="16"><PathIcon Data="{StaticResource IconRepeat}" Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Top" /><Border Background="{DynamicResource TextPrimary}" CornerRadius="5" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"><TextBlock Text="1" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Surface}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Panel></ListBoxItem>
                                                            </ListBox>
                                                        </StackPanel>
                                                    </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    </local:FillHeightPanel>
                                    <WrapPanel x:Name="QuickListTools" Grid.Row="1" Margin="0,10,0,0">
                                        <Button Classes="icon" Click="QuickUp_Click" ToolTip.Tip="Move up" AutomationProperties.Name="Move action up"><PathIcon Data="{StaticResource IconUp}" /></Button>
                                        <Button Classes="icon" Click="QuickDown_Click" ToolTip.Tip="Move down" AutomationProperties.Name="Move action down"><PathIcon Data="{StaticResource IconDown}" /></Button>
                                        <Button Classes="icon" Click="QuickDuplicate_Click" ToolTip.Tip="Duplicate" AutomationProperties.Name="Duplicate action"><PathIcon Data="{StaticResource IconCopy}" /></Button>
                                        <Button Classes="icon" Click="QuickRemove_Click" ToolTip.Tip="Remove" AutomationProperties.Name="Remove action"><PathIcon Data="{StaticResource IconDelete}" /></Button>
                                        <Button Classes="icon" x:Name="QuickUndoButton" Click="QuickUndo_Click" ToolTip.Tip="Undo" AutomationProperties.Name="Undo"><PathIcon Data="{StaticResource IconUndo}" /></Button>
                                        <Button Classes="icon" x:Name="QuickRedoButton" Click="QuickRedo_Click" ToolTip.Tip="Redo" AutomationProperties.Name="Redo"><PathIcon Data="{StaticResource IconRedo}" /></Button>
                                        <Button Classes="icon" x:Name="ClearActionListButton" Click="QuickClear_Click" ToolTip.Tip="Clear list. Undo restores it. Saved macro files are kept." AutomationProperties.Name="Clear action list"><PathIcon Data="{StaticResource IconClear}" /></Button>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="2" ColumnDefinitions="*,128,102">
                                <TextBox x:Name="ActionMacroNameBox" MaxLength="100" MinWidth="45" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip.Tip="Macro name" AutomationProperties.Name="Action list macro name" />
                                <Button Grid.Column="1" Content="Save Macro" Click="SaveProfile_Click" Margin="0,0,8,0" Padding="6,7" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="2" x:Name="LoadMacroButton" Content="Load Macro" Click="LoadMacroFile_Click" Margin="0" Padding="6,7" HorizontalAlignment="Stretch" />
                            </Grid>
                            <TextBlock Grid.Row="3" x:Name="MacroSaveStatus" Classes="secondary optional" Margin="0,4,0,0" />
                            <StackPanel Grid.Row="4" x:Name="QuickAdvanced" Margin="0,12,0,0">
                                <WrapPanel>
                                    <ToggleButton x:Name="RecordMovementBox" Classes="choice" Content="Simulate mouse movement between click points" Margin="0,0,6,6" IsCheckedChanged="ActionsChoice_Changed" />
                                    <ToggleButton x:Name="KeepAwakeBox" Classes="choice" Content="Prevent sleep while running" Margin="0,0,6,6" IsCheckedChanged="KeepAwake_Changed" />
                                </WrapPanel>
                                <StackPanel x:Name="ShutdownSettings" Margin="0,8,0,0">
                                    <ComboBox x:Name="ShutdownModeBox" SelectedIndex="0" SelectionChanged="ShutdownMode_Changed" AutomationProperties.Name="Shutdown PC after">
                                        <ComboBoxItem Content="Shutdown PC after…" IsEnabled="False" />
                                        <ComboBoxItem Content="After X loops" /><ComboBoxItem Content="After X minutes" /><ComboBoxItem Content="At set time" />
                                    </ComboBox>
                                    <StackPanel x:Name="ShutdownNumberFields" IsVisible="False"><TextBlock x:Name="ShutdownValueLabel" Text="Loops" /><TextBox x:Name="ShutdownValueBox" local:Spin.Step="1" local:Spin.Minimum="1" local:Spin.Maximum="100000" Text="100" AutomationProperties.Name="Shutdown value" /></StackPanel>
                                    <StackPanel x:Name="ShutdownTimeFields" IsVisible="False">
                                        <TextBlock Text="System time (24-hour)" />
                                        <WrapPanel>
                                            <TextBox x:Name="ShutdownHourBox" local:Spin.Step="1" local:Spin.Minimum="0" local:Spin.Maximum="23" Width="70" MaxLength="2" AutomationProperties.Name="Shutdown hour" />
                                            <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0" />
                                            <TextBox x:Name="ShutdownMinuteBox" local:Spin.Step="1" local:Spin.Minimum="0" local:Spin.Maximum="59" Width="70" MaxLength="2" AutomationProperties.Name="Shutdown minute" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <Button x:Name="ArmShutdownButton" Content="Enable shutdown…" Click="ArmShutdown_Click" IsVisible="False" HorizontalAlignment="Left" />
                                </StackPanel>
                                <TextBlock x:Name="PowerStatusLabel" Classes="secondary optional" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Retain these empty slots for existing page identifiers. -->
                <Grid IsVisible="False" />
                <Grid IsVisible="False" />

                <!-- Page 3: Settings -->
                <Grid x:Name="SettingsPage" IsVisible="False">
                    <ScrollViewer Padding="0,0,16,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="When closing the window" Classes="heading" />
                            <ToggleButton x:Name="CloseToTrayBox" Classes="choice" Content="Minimize to the top bar" IsChecked="True" HorizontalAlignment="Left" IsCheckedChanged="CloseToTray_Changed" />
                            <TextBlock Text="On: clicking X keeps the clicker running in the top bar. Off: clicking X closes it." Classes="secondary" Margin="0,4,0,0" />
                            <TextBlock Text="Appearance" Classes="heading" Margin="0,18,0,8" />
                            <WrapPanel>
                                <Button x:Name="LightThemeButton" Classes="icon" Width="40" Height="40" Click="LightTheme_Click" ToolTip.Tip="Light mode" AutomationProperties.Name="Light mode"><PathIcon Data="{StaticResource IconSun}" Width="20" Height="20" /></Button>
                                <Button x:Name="DarkThemeButton" Classes="icon" Width="40" Height="40" Click="DarkTheme_Click" ToolTip.Tip="Dark mode" AutomationProperties.Name="Dark mode"><PathIcon Data="{StaticResource IconMoon}" Width="20" Height="20" /></Button>
                            </WrapPanel>
                            <ComboBox x:Name="ThemeBox" IsVisible="False" SelectedIndex="0" SelectionChanged="Theme_Changed"><ComboBoxItem Content="System" /><ComboBoxItem Content="Dark" /><ComboBoxItem Content="Light" /></ComboBox>
                            <TextBlock Text="Overlay" Classes="heading" Margin="0,18,0,8" />
                            <ToggleButton x:Name="OverlayUnlockedBox" Classes="choice" HorizontalAlignment="Left" IsCheckedChanged="OverlayLock_Changed" AutomationProperties.Name="Unlock the overlay" ToolTip.Tip="Locked: the overlay stays at its anchor point and clicks pass through it. Unlocked: drag it anywhere; it keeps that place next to the Click target window. The padlock on the overlay does the same."><StackPanel Orientation="Horizontal"><Border x:Name="OverlayLockPicture" Width="18" Height="18" Margin="0,0,6,0" Background="{DynamicResource TextPrimary}"><Border.OpacityMask><ImageBrush Source="/Assets/Ui/overlay/locked.png" Stretch="Uniform" /></Border.OpacityMask></Border><TextBlock x:Name="OverlayLockText" Text="Overlay locked" VerticalAlignment="Center" /></StackPanel></ToggleButton>
                            <TextBlock Text="Overlay Anchor Point" Margin="0,12,0,4" />
                            <local:OverlayAnchorPicker x:Name="OverlayAnchorPicture" HorizontalAlignment="Left" Fill="{DynamicResource Surface}" Stroke="{DynamicResource Border}" Highlight="{DynamicResource SuccessBorder}" ToolTip.Tip="Click along an edge to pin the overlay there on the Click target window (or the screen, for Desktop)." />
                            <ToggleButton x:Name="IdleOverlayBox" Classes="choice" Content="Show overlay when idle" HorizontalAlignment="Left" Margin="0,12,0,8" IsCheckedChanged="OverlayOptions_Changed" ToolTip.Tip="Keeps the status overlay on screen while nothing runs and the clicker is minimized, so you can see it is there." />
                            <TextBlock Text="Opacity" />
                            <Slider x:Name="OverlayOpacity" Width="300" HorizontalAlignment="Left" Minimum="0.4" Maximum="1" Value="0.94" ValueChanged="OverlayOptions_Changed" AutomationProperties.Name="Overlay opacity" />
                            <TextBlock Text="Size" />
                            <Slider x:Name="OverlayScale" Width="300" HorizontalAlignment="Left" Minimum="0.75" Maximum="1.5" Value="1" ValueChanged="OverlayOptions_Changed" AutomationProperties.Name="Overlay size" />

                            <TextBlock Text="When the click target is resized" Classes="heading" Margin="0,18,0,8" />
                            <ListBox x:Name="ResizeClicksBox" Classes="choice" SelectedIndex="0" SelectionChanged="ResizeClicks_Changed" HorizontalAlignment="Left" AutomationProperties.Name="Click positions after resizing">
                                <ListBoxItem Content="Scale click positions with the window (default)" Padding="10,6" /><ListBoxItem Content="Keep fixed click positions" Padding="10,6" />
                            </ListBox>
                            <TextBlock Classes="secondary" Margin="0,4,0,0">Scale: saved clicks and scroll spots stretch with the window, so they land on the same part of it. Fixed: they keep the same distance from the window's top-left corner.<LineBreak />Drags and colour-wait areas are not changed by this choice. It applies from the next Start or Test.</TextBlock>

                            <TextBlock Text="Global controls" Classes="heading" Margin="0,18,0,8" />
                            <WrapPanel>
                                <StackPanel Width="170" Margin="0,0,12,0"><TextBlock Text="Start / toggle" Margin="0,0,0,4" /><Button x:Name="ToggleKeyBox" Content="Choose a key…" Click="CaptureStartKey_Click" HorizontalAlignment="Stretch" AutomationProperties.Name="Start hotkey" /></StackPanel>
                                <StackPanel Width="170" Margin="0,0,12,0"><TextBlock Text="Stop all" Margin="0,0,0,4" /><Button x:Name="StopKeyBox" Content="Choose a key…" Click="CaptureStopKey_Click" HorizontalAlignment="Stretch" AutomationProperties.Name="Stop all hotkey" /></StackPanel>
                                <StackPanel Width="170" Margin="0,0,12,0"><TextBlock Text="Record Macro / Stop" Margin="0,0,0,4" /><Button x:Name="QuickRecordKeyBox" Content="F10" Click="CaptureRecordKey_Click" HorizontalAlignment="Stretch" AutomationProperties.Name="Record macro hotkey" /></StackPanel>
                                <StackPanel x:Name="ScreenshotHotkeyPanel" Width="170"><TextBlock Text="Screenshot" Margin="0,0,0,4" /><Button x:Name="ScreenshotKeyBox" Content="Choose a key…" Click="CaptureScreenshotKey_Click" HorizontalAlignment="Stretch" AutomationProperties.Name="Screenshot hotkey" /></StackPanel>
                            </WrapPanel>
                            <CheckBox x:Name="ScreenshotHotkeyBox" IsVisible="False" />
                            <Button Content="Reset keybinds" Click="ResetGlobalKeys_Click" Classes="reset" HorizontalAlignment="Left" MinWidth="164" Padding="2,6" Margin="0,12,0,0" />
                            <TextBlock x:Name="HotkeyStatus" Classes="secondary optional" Margin="0,8,0,0" />
                            <TextBlock x:Name="ScreenshotHotkeyStatus" Classes="secondary optional" />

                            <TextBlock Text="Controller" Classes="heading" Margin="0,18,0,8" />
                            <TextBlock x:Name="ControllerStatus" Classes="secondary" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,0,6" />
                            <WrapPanel>
                                <StackPanel Width="170" Margin="0,0,12,0"><TextBlock Text="Start / toggle" Margin="0,0,0,4" /><Button x:Name="ControllerStartBox" Tag="StartStop" Content="A" Click="CaptureControllerButton_Click" PointerReleased="ClearControllerButton_Click" HorizontalAlignment="Stretch" ToolTip.Tip="Click, then press a controller button. Right-click to leave it without one." AutomationProperties.Name="Start controller button" /></StackPanel>
                                <StackPanel Width="170" Margin="0,0,12,0"><TextBlock Text="Stop all" Margin="0,0,0,4" /><Button x:Name="ControllerStopBox" Tag="StopAll" Content="B" Click="CaptureControllerButton_Click" PointerReleased="ClearControllerButton_Click" HorizontalAlignment="Stretch" ToolTip.Tip="Click, then press a controller button. Right-click to leave it without one." AutomationProperties.Name="Stop all controller button" /></StackPanel>
                                <StackPanel Width="170" Margin="0,0,12,0"><TextBlock Text="Record Macro / Stop" Margin="0,0,0,4" /><Button x:Name="ControllerRecordBox" Tag="Record" Content="Y" Click="CaptureControllerButton_Click" PointerReleased="ClearControllerButton_Click" HorizontalAlignment="Stretch" ToolTip.Tip="Click, then press a controller button. Right-click to leave it without one." AutomationProperties.Name="Record controller button" /></StackPanel>
                                <StackPanel Width="170"><TextBlock Text="Screenshot" Margin="0,0,0,4" /><Button x:Name="ControllerScreenshotBox" Tag="Screenshot" Content="X" Click="CaptureControllerButton_Click" PointerReleased="ClearControllerButton_Click" HorizontalAlignment="Stretch" ToolTip.Tip="Click, then press a controller button. Right-click to leave it without one." AutomationProperties.Name="Screenshot controller button" /></StackPanel>
                            </WrapPanel>
                            <Button Content="Reset controller buttons" Click="ResetControllerButtons_Click" Classes="reset" HorizontalAlignment="Left" MinWidth="164" Padding="2,6" Margin="0,12,0,0" />
                            <TextBlock x:Name="ControllerBindStatus" Classes="secondary optional" Margin="0,8,0,0" />

                            <TextBlock Text="Emergency stop" Classes="heading" Margin="0,18,0,8" />
                            <ListBox x:Name="EmergencyStopBox" Classes="choice" SelectedIndex="0" SelectionChanged="EmergencyStop_Changed" HorizontalAlignment="Left" AutomationProperties.Name="Emergency stop">
                                <ListBoxItem Content="Stop All F9" Padding="10,6" ToolTip.Tip="Only Stop All stops the clicker (default)." /><ListBoxItem Content="Stop All Any Input" Padding="10,6" ToolTip.Tip="Any key you press or mouse movement stops the clicker." />
                            </ListBox>
                            <TextBlock x:Name="EmergencyStopHint" Classes="secondary" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" />

                            <TextBlock Text="Linux setup" Classes="heading" Margin="0,18,0,8" />
                            <Border Classes="card" x:Name="LinuxSetupCard">
                                <StackPanel>
                                    <TextBlock x:Name="LinuxSessionLabel" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    <TextBlock x:Name="HelperHeading" Text="GNOME helper" FontWeight="SemiBold" Margin="0,10,0,0" />
                                    <TextBlock x:Name="HelperStatusLabel" Classes="secondary" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button x:Name="InstallHelperButton" Content="Install GNOME helper" Click="InstallHelper_Click" Classes="green" />
                                    </WrapPanel>
                                    <TextBlock Text="Physical input access - This is only for the current user" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="InputAccessLabel" Classes="secondary" />
                                    <Button x:Name="InputAccessOnButton" Content="Turn on" Click="InputAccessOn_Click" Margin="0,6,0,0" Classes="green" ToolTip.Tip="Asks for your password in the system's own window, then turns input access on." />
                                    <TextBlock x:Name="InputAccessTerminalHint" Text="Or run this once in a terminal:" Classes="secondary" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <SelectableTextBlock x:Name="InputAccessCommand" FontFamily="monospace" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <Button x:Name="CopyInputCommandButton" Content="Copy command" Click="CopyInputCommand_Click" Margin="0,6,0,0" />
                                    <TextBlock x:Name="InputAccessScope" Text="Disable with:" Classes="secondary" Margin="0,10,0,0" TextWrapping="Wrap" />
                                    <Button x:Name="InputAccessOffButton" Content="Turn off" Click="InputAccessOff_Click" Margin="0,6,0,0" ToolTip.Tip="Asks for your password in the system's own window, then removes the rule and the access it gave." />
                                    <SelectableTextBlock x:Name="InputAccessRemoveCommand" FontFamily="monospace" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <Button x:Name="CopyRemoveCommandButton" Content="Copy command" Click="CopyRemoveCommand_Click" Margin="0,6,0,0" />
                                    <Button x:Name="CheckInputAccessButton" Content="Check again" Click="RefreshPlatform_Click" Margin="0,10,0,0" Classes="red" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Page 4: Toggles -->
                <Grid x:Name="TogglePage" IsVisible="False" ColumnDefinitions="*,25,*">
                    <Border Grid.Column="1" Width="1" Background="{DynamicResource Border}" HorizontalAlignment="Center" />
                    <ScrollViewer Padding="0,0,16,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Pick a target" Classes="heading" />
                            <Border x:Name="ToggleTargetCard" Classes="card" BorderThickness="2">
                                <StackPanel>
                                    <TextBlock Text="Click target" FontWeight="SemiBold" />
                                    <ComboBox x:Name="ToggleTargetLabel" DropDownOpened="ClickTargets_Opened" SelectionChanged="ClickTarget_Changed" AutomationProperties.Name="Toggle click target" DisplayMemberBinding="{Binding Title, x:DataType=linux:TargetWindow}" />
                                    <TextBlock Text="Toggles only work when a click target is selected." Classes="secondary" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Create Toggle" Classes="heading" Margin="0,10,0,8" />
                            <Border Classes="card" BorderBrush="{DynamicResource ActionBorder}" BorderThickness="2">
                                <StackPanel>
                                    <TextBlock Text="Toggle name" />
                                    <TextBox x:Name="ToggleNameBox" MaxLength="100" AutomationProperties.Name="Toggle name" />
                                    <TextBlock Text="Key or mouse button to hold or tap" />
                                    <Button x:Name="ToggleHeldKeyBox" Content="Choose a key…" Click="CaptureHeldInput_Click" HorizontalAlignment="Stretch" AutomationProperties.Name="Key to hold" Margin="0,4,0,12" />
                                    <Grid Margin="0,0,0,12" ColumnDefinitions="Auto,*">
                                        <ListBox x:Name="ToggleModeBox" Classes="choice" VerticalAlignment="Top" SelectedIndex="0" SelectionChanged="ToggleMode_Changed" Margin="0,4,10,0" AutomationProperties.Name="Toggle behavior"><ListBoxItem Content="Hold" Padding="10,6" /><ListBoxItem Content="Spam" Padding="10,6" ToolTip.Tip="Taps the key or button as fast as its interval allows. Spam is deliberately not limited by the Actions click cap." /></ListBox>
                                        <StackPanel Grid.Column="1" x:Name="ToggleIntervalPanel" IsVisible="False">
                                            <TextBlock x:Name="ToggleIntervalLabel" Text="100 ms · 10 taps/sec" />
                                            <Slider x:Name="ToggleIntervalSlider" Minimum="10" Maximum="1000" Value="100" TickFrequency="10" IsSnapToTickEnabled="True" SmallChange="10" LargeChange="100" ValueChanged="ToggleInterval_Changed" AutomationProperties.Name="Spam interval in milliseconds" />
                                            <TextBlock Text="Shorter interval = faster. Shared limit: 100 taps/sec." Classes="secondary" FontSize="12" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Toggle shortcut" />
                                    <!-- A key or mouse button, a controller button, or both switch the toggle; right-click one to remove it. -->
                                    <Grid Margin="0,4,0,0" ColumnDefinitions="*,*">
                                        <Button x:Name="ToggleShortcutBox" Content="Keyboard/Mouse" Click="CaptureToggleKey_Click" PointerReleased="ClearToggleKey_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,3,0" ToolTip.Tip="A key or mouse button that switches this toggle on and off. Right-click to remove it." AutomationProperties.Name="Toggle keyboard or mouse shortcut" />
                                        <Button Grid.Column="1" x:Name="ToggleControllerBox" Content="Controller" Click="CaptureToggleController_Click" PointerReleased="ClearToggleController_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3,0,0,0" ToolTip.Tip="A controller button that switches this toggle on and off. Right-click to remove it." AutomationProperties.Name="Toggle controller button" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Classes="icon" x:Name="SaveToggleButton" Click="SaveToggle_Click" ToolTip.Tip="Add toggle" AutomationProperties.Name="Save toggle"><PathIcon Data="{StaticResource IconSave}" /></Button>
                                <Button Classes="icon" Click="NewToggle_Click" ToolTip.Tip="New toggle" AutomationProperties.Name="New toggle"><PathIcon Data="{StaticResource IconAdd}" /></Button>
                                <Button Classes="icon" x:Name="DeleteToggleButton" Click="DeleteToggle_Click" IsEnabled="False" ToolTip.Tip="Remove toggle" AutomationProperties.Name="Remove toggle"><PathIcon Data="{StaticResource IconDelete}" /></Button>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer Grid.Column="2" Padding="0,0,16,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Toggle List" Classes="heading" />
                            <Border Classes="card" BorderBrush="{DynamicResource ListBorder}" BorderThickness="2">
                                <StackPanel>
                                    <TextBlock x:Name="ToggleEmptyLabel" Text="Create your first toggle on the left." Classes="secondary" />
                                    <DataGrid x:Name="ToggleList" MinHeight="200" MaxHeight="320" AutoGenerateColumns="False" CanUserReorderColumns="False" CanUserResizeColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" RowHeight="40" GridLinesVisibility="All" SelectionChanged="ToggleSelection_Changed" AutomationProperties.Name="Saved toggles" x:CompileBindings="False">
                                        <DataGrid.Styles>
                                            <!-- Headers stretch so each column's own header text decides its alignment. -->
                                            <Style Selector="DataGridColumnHeader"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                                        </DataGrid.Styles>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="*" MinWidth="80">
                                                <DataGridTemplateColumn.Header><TextBlock Text="Name" Margin="6,0" /></DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Name}" Margin="14,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Width="92">
                                                <DataGridTemplateColumn.Header><TextBlock Text="Hold / Tap" HorizontalAlignment="Center" /></DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate><ContentControl Content="{Binding HeldPicture}" Margin="4,3" HorizontalAlignment="Center" VerticalAlignment="Center" /></DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Width="104">
                                                <DataGridTemplateColumn.Header><TextBlock Text="Hotkey" HorizontalAlignment="Center" /></DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate><ContentControl Content="{Binding ShortcutPicture}" Margin="4,3" HorizontalAlignment="Center" VerticalAlignment="Center" /></DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Width="92">
                                                <DataGridTemplateColumn.Header><TextBlock Text="Toggle" HorizontalAlignment="Center" /></DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ToggleButton Classes="choice active" IsChecked="{Binding Enabled, Mode=OneWay}" Click="ToggleEnabled_Changed" ToolTip.Tip="Enable this shortcut; press it to hold or release." AutomationProperties.Name="Enable toggle shortcut" Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Autorun is an example toggle: hold W on/off for games without autorun." Classes="secondary" Margin="0,6,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Page 5: retained guide slot (not shown in navigation, as in the Windows build). -->
                <Grid x:Name="WizardPage" IsVisible="False" />

                <!-- Page 6: Screenshot -->
                <Grid x:Name="ScreenshotPage" IsVisible="False">
                    <ScrollViewer Padding="0,0,16,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Save a screenshot as a PNG. ME Clicker hides while you capture." Classes="secondary" Margin="0,0,0,12" />
                            <Border Classes="card" BorderBrush="{DynamicResource ActionBorder}">
                                <StackPanel>
                                    <TextBlock Text="Capture" FontWeight="SemiBold" />
                                    <ListBox x:Name="ScreenshotModeBox" Classes="choice" SelectedIndex="1" SelectionChanged="ScreenshotOptions_Changed" HorizontalAlignment="Left" Margin="0,6,0,12" AutomationProperties.Name="Screenshot area"><ListBoxItem Content="Full screen (all monitors)" Padding="10,6" /><ListBoxItem Content="Select an area" Padding="10,6" /></ListBox>
                                    <TextBlock Text="Save to folder" FontWeight="SemiBold" />
                                    <DockPanel Margin="0,6,0,8">
                                        <Button DockPanel.Dock="Right" Content="Choose folder…" Click="ScreenshotFolder_Click" Height="{Binding #ScreenshotFolderBox.Bounds.Height}" MinHeight="0" Padding="10,0" Margin="6,0,6,0" />
                                        <TextBox x:Name="ScreenshotFolderBox" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0" AutomationProperties.Name="Screenshot save folder" />
                                    </DockPanel>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <WrapPanel VerticalAlignment="Bottom">
                                            <Button x:Name="TakeScreenshotButton" Content="Take Screenshot" Classes="green" Click="TakeScreenshot_Click" />
                                            <Button Content="Open folder" Click="ScreenshotOpenFolder_Click" />
                                        </WrapPanel>
                                        <WrapPanel Grid.Column="1" VerticalAlignment="Bottom">
                                            <ToggleButton x:Name="ScreenshotClipboardBox" Classes="choice" Content="Copy to clipboard" ToolTip.Tip="Each screenshot is also put on the clipboard, ready to paste." IsCheckedChanged="ScreenshotOptions_Changed" />
                                            <ToggleButton x:Name="ScreenshotDailyFoldersBox" Classes="choice" Content="Organize into daily folders" ToolTip.Tip="Screenshots go into a folder per day inside the save folder." IsCheckedChanged="ScreenshotOptions_Changed" />
                                        </WrapPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="ScreenshotStatus" Text="Ready to capture." TextWrapping="Wrap" Margin="0,4,0,8" />
                            <Image x:Name="ScreenshotPreview" Stretch="Uniform" MaxHeight="210" MaxWidth="480" HorizontalAlignment="Left" />
                            <TextBlock x:Name="ScreenshotLastFile" Classes="secondary" Margin="0,8,0,6" />
                            <Button x:Name="ScreenshotOpenFileButton" Content="Open last screenshot" Click="ScreenshotOpenFile_Click" IsEnabled="False" HorizontalAlignment="Left" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Page 7: Controller to Key (its tab sits between Toggles and Screenshot). -->
                <Grid x:Name="ControllerPage" IsVisible="False" ColumnDefinitions="*,25,*">
                    <Border Grid.Column="1" Width="1" Background="{DynamicResource Border}" HorizontalAlignment="Center" />
                    <ScrollViewer Padding="0,0,16,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Create Controller to Key" Classes="heading" />
                            <Border Classes="card" BorderBrush="{DynamicResource ActionBorder}" BorderThickness="2">
                                <StackPanel>
                                    <TextBlock Text="Bind name" />
                                    <TextBox x:Name="ControllerBindNameBox" MaxLength="100" AutomationProperties.Name="Bind name" />
                                    <TextBlock Text="Key or mouse button to press" Margin="0,8,0,0" />
                                    <Button x:Name="ControllerOutputBox" Classes="needs-choice" Content="Choose a key or mouse button…" Click="ChooseBindOutput_Click" HorizontalAlignment="Stretch" AutomationProperties.Name="Key or mouse button to press" Margin="0,4,0,12" />
                                    <TextBlock Text="Controller binding" />
                                    <Button x:Name="ControllerBindButtonBox" Content="Press to choose a button…" Classes="needs-choice" Click="CaptureBindButton_Click" HorizontalAlignment="Stretch" AutomationProperties.Name="Controller binding" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Classes="icon" x:Name="SaveControllerBindButton" Click="SaveControllerBind_Click" ToolTip.Tip="Add bind" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="Save bind"><PathIcon Data="{StaticResource IconSave}" /></Button>
                                <Button Classes="icon" Click="NewControllerBind_Click" ToolTip.Tip="New bind" AutomationProperties.Name="New bind"><PathIcon Data="{StaticResource IconAdd}" /></Button>
                                <Button Classes="icon" x:Name="DeleteControllerBindButton" Click="DeleteControllerBind_Click" IsEnabled="False" ToolTip.Tip="Remove bind" AutomationProperties.Name="Remove bind"><PathIcon Data="{StaticResource IconDelete}" /></Button>
                            </WrapPanel>
                            <TextBlock x:Name="ControllerBindStatusLabel" Classes="secondary optional" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer Grid.Column="2" Padding="0,0,16,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Controller to Key List" Classes="heading" />
                            <Border Classes="card" BorderBrush="{DynamicResource ListBorder}" BorderThickness="2">
                                <StackPanel>
                                    <TextBlock x:Name="ControllerBindEmptyLabel" Text="Create your first bind on the left." Classes="secondary" />
                                    <DataGrid x:Name="ControllerBindList" MinHeight="200" MaxHeight="420" AutoGenerateColumns="False" CanUserReorderColumns="False" CanUserResizeColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="ControllerBindSelection_Changed" AutomationProperties.Name="Controller to Key binds" x:CompileBindings="False">
                                        <DataGrid.Styles>
                                            <Style Selector="DataGridColumnHeader"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                                        </DataGrid.Styles>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="*" MinWidth="80">
                                                <DataGridTemplateColumn.Header><TextBlock Text="Name" Margin="6,0" /></DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Name}" Margin="14,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Width="96">
                                                <DataGridTemplateColumn.Header><TextBlock Text="Controller" HorizontalAlignment="Center" /></DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate><ContentControl Content="{Binding ButtonPicture}" Margin="4,3" HorizontalAlignment="Center" VerticalAlignment="Center" /></DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Width="96">
                                                <DataGridTemplateColumn.Header><TextBlock Text="Presses" HorizontalAlignment="Center" /></DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate><ContentControl Content="{Binding OutputPicture}" Margin="4,3" HorizontalAlignment="Center" VerticalAlignment="Center" /></DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Width="92">
                                                <DataGridTemplateColumn.Header><TextBlock Text="Bind" HorizontalAlignment="Center" /></DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ToggleButton Classes="choice active" IsChecked="{Binding Active, Mode=OneWay}" Click="ControllerBindActive_Click" ToolTip.Tip="Active binds press their key while their controller button is held." AutomationProperties.Name="Bind active" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="ControllerBindControllerLabel" Classes="secondary" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Panel>
            <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="10" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock x:Name="ReasonLabel" Text="Choose a target to begin." Classes="secondary" />
                    <TextBlock x:Name="PowerBanner" IsVisible="False" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
