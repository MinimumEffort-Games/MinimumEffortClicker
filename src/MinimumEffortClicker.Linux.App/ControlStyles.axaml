<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The Windows build's control treatment, rebuilt over Avalonia's Fluent theme. Brushes come
         from AppTheme, so light and dark modes match the WPF palette. -->
    <Styles.Resources>
        <!-- Simple line icons drawn for this app (24 × 24). The Windows build uses Segoe Fluent Icons. -->
        <StreamGeometry x:Key="IconUp">M12,4 L19.5,12 L14.5,12 L14.5,20 L9.5,20 L9.5,12 L4.5,12 Z</StreamGeometry>
        <StreamGeometry x:Key="IconDown">M12,20 L4.5,12 L9.5,12 L9.5,4 L14.5,4 L14.5,12 L19.5,12 Z</StreamGeometry>
        <StreamGeometry x:Key="IconCopy">F1 M8,8 L20,8 L20,20 L8,20 Z M10,10 L10,18 L18,18 L18,10 Z M4,4 L16,4 L16,6 L6,6 L6,16 L4,16 Z</StreamGeometry>
        <StreamGeometry x:Key="IconDelete">F1 M9,2 L15,2 L15,4 L20,4 L20,6 L4,6 L4,4 L9,4 Z M5.5,7.5 L18.5,7.5 L17.5,22 L6.5,22 Z M9,10 L9,19.5 L10.5,19.5 L10.5,10 Z M13.5,10 L13.5,19.5 L15,19.5 L15,10 Z</StreamGeometry>
        <StreamGeometry x:Key="IconUndo">M9,4 L2.5,9.5 L9,15 L9,11.5 C13.5,11.5 17,13 19.5,18.5 C19.5,12 15.5,8 9,8 Z</StreamGeometry>
        <StreamGeometry x:Key="IconRedo">M15,4 L21.5,9.5 L15,15 L15,11.5 C10.5,11.5 7,13 4.5,18.5 C4.5,12 8.5,8 15,8 Z</StreamGeometry>
        <StreamGeometry x:Key="IconClear">M6.4,5 L12,10.6 L17.6,5 L19,6.4 L13.4,12 L19,17.6 L17.6,19 L12,13.4 L6.4,19 L5,17.6 L10.6,12 L5,6.4 Z</StreamGeometry>
        <StreamGeometry x:Key="IconSun">M12,7 A5,5 0 1 1 11.99,7 Z M11,1 L13,1 L13,4.5 L11,4.5 Z M11,19.5 L13,19.5 L13,23 L11,23 Z M1,11 L4.5,11 L4.5,13 L1,13 Z M19.5,11 L23,11 L23,13 L19.5,13 Z M3.9,5.3 L5.3,3.9 L7.8,6.4 L6.4,7.8 Z M16.2,17.6 L17.6,16.2 L20.1,18.7 L18.7,20.1 Z M3.9,18.7 L6.4,16.2 L7.8,17.6 L5.3,20.1 Z M16.2,6.4 L18.7,3.9 L20.1,5.3 L17.6,7.8 Z</StreamGeometry>
        <StreamGeometry x:Key="IconMoon">M14,2.5 A9.5,9.5 0 1 0 21.5,14 A7.5,7.5 0 1 1 14,2.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconSave">F1 M3,3 L17,3 L21,7 L21,21 L3,21 Z M6,5 L6,10 L15,10 L15,5 Z M7,14 L7,19 L17,19 L17,14 Z</StreamGeometry>
        <StreamGeometry x:Key="IconAdd">M11,4 L13,4 L13,11 L20,11 L20,13 L13,13 L13,20 L11,20 L11,13 L4,13 L4,11 L11,11 Z</StreamGeometry>
        <!-- Repeat (two arrows chasing round a loop), like a music player's repeat button; Once adds a 1 in its middle. -->
        <StreamGeometry x:Key="IconRepeat">M7,6 L17,6 L17,3 L21.5,7.5 L17,12 L17,9 L7,9 C5.9,9 5,9.9 5,11 L5,13 L2,13 L2,11 C2,8.2 4.2,6 7,6 Z M17,18 L7,18 L7,21 L2.5,16.5 L7,12 L7,15 L17,15 C18.1,15 19,14.1 19,13 L19,11 L22,11 L22,13 C22,15.8 19.8,18 17,18 Z</StreamGeometry>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Buttons: the pre-pixel treatment with compact spacing. -->
    <Style Selector="Button">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Background" Value="{DynamicResource RaisedSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.green">
        <Setter Property="Background" Value="{DynamicResource SuccessFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource ColourButtonText}" />
    </Style>
    <Style Selector="Button.blue">
        <Setter Property="Background" Value="{DynamicResource ActionFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ActionBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource ColourButtonText}" />
    </Style>
    <Style Selector="Button.red">
        <Setter Property="Background" Value="{DynamicResource StopFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StopBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource ColourButtonText}" />
    </Style>
    <!-- A button that still needs a choice: outlined red, not filled, so it is noticed without competing with Stop and Record. -->
    <Style Selector="Button.needs-choice">
        <Setter Property="BorderBrush" Value="{DynamicResource StopBorder}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.chosen">
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorder}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,5,0" />
    </Style>
    <Style Selector="Button.icon PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FocusRing}" />
        <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FocusRing}" />
        <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
        <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
        <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Margin" Value="0,4,0,8" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Margin" Value="0,4,0,8" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Navigation and list rows. -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RaisedSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="ListBoxItem:selected">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RaisedSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="ListBox.navigation ListBoxItem">
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="RowBackground" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Border}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Border}" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource RaisedSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <!-- On/off choices and rows of choices. A green outline means chosen; it is drawn over the button (the Ring), so
         the text never moves. The face is not named PART_ContentPresenter, so the Fluent theme's checked and selected
         colours do not reach it. -->
    <Style Selector="ToggleButton.choice">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Background" Value="{DynamicResource RaisedSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <ContentPresenter Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                                      Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True" />
                    <Border Name="Ring" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="2" BorderBrush="{DynamicResource FocusRing}" IsVisible="False" IsHitTestVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.choice:pointerover /template/ ContentPresenter#Face"><Setter Property="BorderBrush" Value="{DynamicResource FocusRing}" /></Style>
    <Style Selector="ToggleButton.choice:focus-visible /template/ Border#Ring"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="ToggleButton.choice:checked /template/ Border#Ring">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorder}" />
    </Style>
    <Style Selector="ToggleButton.choice:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
    <!-- Two choices stacked beside a big button (Loop / Minimize on Start): compact, so together they are as tall as it. -->
    <Style Selector="ToggleButton.stacked">
        <Setter Property="Padding" Value="10,1" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <!-- A keycap picture as an on/off choice (Ctrl, Shift, Alt): no button face, only the outline when chosen. -->
    <Style Selector="ToggleButton.keycap">
        <Setter Property="Padding" Value="2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- A list row's on/off switch: "Active" with a green outline, or "Inactive" with a red one. -->
    <Style Selector="ToggleButton.active">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="74" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource StopBorder}" />
        <Setter Property="Content" Value="Inactive" />
    </Style>
    <Style Selector="ToggleButton.active:checked"><Setter Property="Content" Value="Active" /></Style>

    <Style Selector="ListBox.choice">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel"><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></Setter>
    </Style>
    <Style Selector="ListBox.choice > ListBoxItem">
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <ContentPresenter Name="Face" Background="{DynamicResource RaisedSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6"
                                      Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Foreground="{DynamicResource TextPrimary}" />
                    <Border Name="Ring" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource FocusRing}" IsVisible="False" IsHitTestVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.choice > ListBoxItem:selected"><Setter Property="FontWeight" Value="Normal" /></Style>
    <Style Selector="ListBox.choice > ListBoxItem:pointerover /template/ ContentPresenter#Face"><Setter Property="BorderBrush" Value="{DynamicResource FocusRing}" /></Style>
    <Style Selector="ListBox.choice > ListBoxItem:focus-visible /template/ Border#Ring"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="ListBox.choice > ListBoxItem:selected /template/ Border#Ring">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorder}" />
    </Style>
    <Style Selector="ListBox.choice > ListBoxItem:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
    <!-- Choices that share a fixed width and height between them (ms / Seconds beside a number field). -->
    <Style Selector="ListBox.fill"><Setter Property="ItemsPanel"><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></Setter></Style>
    <Style Selector="ListBox.fill > ListBoxItem">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Padding" Value="4,0,4,2" />
    </Style>
    <!-- Repeating / Once under a row's Active button: two small squares spread across the button's width. -->
    <Style Selector="ListBox.repeat"><Setter Property="ItemsPanel"><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></Setter></Style>
    <Style Selector="ListBox.repeat > ListBoxItem">
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Height" Value="24" />
    </Style>

    <!-- A keycap picture as a button (the key picker). -->
    <Style Selector="Button.keycap">
        <Setter Property="Padding" Value="1" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.keycap.chosen"><Setter Property="BorderBrush" Value="{DynamicResource SuccessBorder}" /></Style>
    <!-- Puts something back to its defaults: outlined red so it is not pressed by accident. -->
    <Style Selector="Button.reset">
        <Setter Property="BorderBrush" Value="{DynamicResource StopBorder}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
</Styles>
