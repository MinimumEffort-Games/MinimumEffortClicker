<Window x:Class="MinimumEffortClicker.App.SequenceEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Sequence editor · Minimum Effort Clicker" Width="940" Height="700" MinWidth="760" MinHeight="580"
 FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}"
 Closing="Editor_Closing" SizeChanged="Editor_SizeChanged">
 <Window.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource StandardButton}"><Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="0,0,8,8"/></Style>
  <Style x:Key="ChildTextEditor" TargetType="TextBox" BasedOn="{StaticResource StandardTextBox}"><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="4,2"/><Setter Property="MinHeight" Value="24"/></Style>
  <Style x:Key="ChildChoiceEditor" TargetType="ComboBox" BasedOn="{StaticResource StandardComboBox}"><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="26"/></Style>
  
  
  
 </Window.Resources>
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer x:Name="AuthoringScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel x:Name="AuthoringHeader">
   <TextBlock Text="Macro steps" FontSize="22" FontWeight="SemiBold"/>
   <TextBlock Text="Idle waits and held-input durations are separate. Timing edits preserve overlap." Margin="0,6,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
   <WrapPanel>
    <Button Content="Add key / click" Click="AddInput_Click"/>
    <Button Content="Add wait" Click="AddWait_Click"/>
    <Button Content="Type text" Click="AddText_Click"/>
    <Button Content="Wait for image / colour…" Click="AddCondition_Click"/>
    <Button Content="Add timed group" Click="AddGroup_Click"/>
    <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click"/>
    <Button x:Name="RedoButton" Content="Redo" Click="Redo_Click"/>
    <Button Content="Preview · no input" Click="Preview_Click"/>
    <Button Content="Timing view…" Click="Timing_Click"/>
    <Button Content="Make subsequence" Click="MakeSubsequence_Click"/>
    <Button Content="Subsequences…" Click="Subsequences_Click"/>
    <Button Content="If / repeat…" Click="AddFlow_Click"/>
    <Button x:Name="LoopSettingsButton" Content="Loop settings…" Click="Repetition_Click"/>
    <Button x:Name="RecordButton" Content="Append recording" Click="Record_Click"/>
    <Button x:Name="ReplaceRecordButton" Content="Re-record selected action" Click="ReplaceRecord_Click"/>
   </WrapPanel>
   <WrapPanel><TextBlock Text="Record / finish:" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="RecordKeyBox" Width="75" AutomationProperties.Name="Record hotkey"/><Button Content="Set record key" Click="ApplyRecordKey_Click"/><TextBlock x:Name="RecordKeyStatus" Text="F10 starts and finishes recording" TextWrapping="Wrap" VerticalAlignment="Center"/></WrapPanel>
   <WrapPanel><CheckBox x:Name="CaptureKeysBox" Content="Keyboard" IsChecked="True" Margin="0,0,16,0"/><CheckBox x:Name="CaptureMouseBox" Content="Mouse buttons" IsChecked="True" Margin="0,0,16,0"/><CheckBox x:Name="CaptureScrollBox" Content="Scroll" IsChecked="True" Margin="0,0,16,0"/><CheckBox x:Name="CapturePathsBox" Content="Mouse movement" IsChecked="True" Margin="0"/></WrapPanel>
  </StackPanel>
  </ScrollViewer>
  <Grid x:Name="EditorBody" Grid.Row="1" Margin="0,8,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel>
    <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
     <Button Content="Move up" Click="MoveUp_Click"/><Button Content="Move down" Click="MoveDown_Click"/>
     <Button Content="Duplicate" Click="Duplicate_Click"/><Button Content="Delete" Click="Delete_Click"/>
     <Button Content="Copy" Click="Copy_Click"/><Button Content="Paste" Click="Paste_Click"/>
    </WrapPanel>
    <ListBox x:Name="StepsList" SelectionMode="Extended" SelectionChanged="Selection_Changed" PreviewKeyDown="Steps_KeyDown" Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource Border}" AutomationProperties.Name="Editable action sequence"/>
   </DockPanel>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="Selected action" FontSize="18" FontWeight="SemiBold"/>
     <Button Content="Apply action edit" Click="Apply_Click" HorizontalAlignment="Left"/>
     <TextBlock Text="Save, preview and run also apply the current action. Apply before selecting another action." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
     <CheckBox x:Name="StepEnabled" Content="Include this action"/>
     <TextBlock Text="Name"/><TextBox x:Name="StepName" MaxLength="100" AutomationProperties.Name="Action name"/>
     <TextBlock Text="Notes"/><TextBox x:Name="StepNotes" MaxLength="4000" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Action notes"/>
     <StackPanel x:Name="TextInspector" Visibility="Collapsed">
      <TextBlock Text="Explicit Unicode text · not physical game keys. Review the target text field before running." TextWrapping="Wrap"/>
      <TextBox x:Name="TextContent" MaxLength="1024" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Unicode text to type"/>
      <TextBlock Text="Saved in the profile and its exports. Use key actions for Enter or Tab. Duration must allow at least 10 ms per UTF-16 unit." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
     </StackPanel>
     <TextBlock Text="Duration (milliseconds) · hold, wait or group length" TextWrapping="Wrap"/>
     <TextBox x:Name="DurationBox" AutomationProperties.Name="Action duration in milliseconds"/>
     <Button x:Name="EditConditionButton" Content="Edit condition, timeout and sampling…" Click="EditCondition_Click" Visibility="Collapsed" HorizontalAlignment="Left"/>
     <Button x:Name="EditFlowButton" Content="Edit branches / repeat bound…" Click="EditFlow_Click" Visibility="Collapsed" HorizontalAlignment="Left"/>
     <TextBlock Text="Input"/><ComboBox x:Name="InputBox" AutomationProperties.Name="Action input"/>
     <TextBlock Text="Saved point (from this folder)"/><ComboBox x:Name="NamedPointBox" AutomationProperties.Name="Action named point"/>
     <TextBlock x:Name="PositionLabel" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
     <WrapPanel x:Name="PositionFields">
      <StackPanel Width="100" Margin="0,0,12,0"><TextBlock Text="Start X"/><TextBox x:Name="PositionX" AutomationProperties.Name="Start client X"/></StackPanel>
      <StackPanel Width="100" Margin="0,0,12,0"><TextBlock Text="Start Y"/><TextBox x:Name="PositionY" AutomationProperties.Name="Start client Y"/></StackPanel>
      <StackPanel Width="100" Margin="0,0,12,0"><TextBlock Text="End X"/><TextBox x:Name="EndX" AutomationProperties.Name="End client X"/></StackPanel>
      <StackPanel Width="100"><TextBlock Text="End Y"/><TextBox x:Name="EndY" AutomationProperties.Name="End client Y"/></StackPanel>
     </WrapPanel>
     <StackPanel x:Name="GroupInspector" Visibility="Collapsed">
      <TextBlock Text="Timed children · offsets from group start" FontWeight="SemiBold" Margin="0,4,0,10"/>
      <Border Padding="7" Background="{DynamicResource Surface}"><DataGrid x:Name="ChildrenGrid" Height="180" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}" HeadersVisibility="Column" AutomationProperties.Name="Editable timed children">
       <DataGrid.Columns>
        <DataGridComboBoxColumn x:Name="ChildInputColumn" Header="Input" SelectedItemBinding="{Binding Input}" Width="*" MinWidth="140" ElementStyle="{StaticResource ChildChoiceEditor}" EditingElementStyle="{StaticResource ChildChoiceEditor}"/>
        <DataGridTextColumn Header="Offset ms" Binding="{Binding Offset}" Width="110" EditingElementStyle="{StaticResource ChildTextEditor}"/>
        <DataGridTextColumn Header="Hold ms" Binding="{Binding Duration}" Width="90" EditingElementStyle="{StaticResource ChildTextEditor}"/>
        <DataGridComboBoxColumn x:Name="ChildPointColumn" Header="Named point" SelectedItemBinding="{Binding Target}" Width="180" ElementStyle="{StaticResource ChildChoiceEditor}" EditingElementStyle="{StaticResource ChildChoiceEditor}"/>
        <DataGridTextColumn Header="Position" Binding="{Binding PositionLabel}" IsReadOnly="True" Width="150"/>
        <DataGridTextColumn Header="Start X" Binding="{Binding X}" Width="90" EditingElementStyle="{StaticResource ChildTextEditor}"/>
        <DataGridTextColumn Header="Start Y" Binding="{Binding Y}" Width="90" EditingElementStyle="{StaticResource ChildTextEditor}"/>
        <DataGridTextColumn Header="End X" Binding="{Binding EndX}" Width="80" EditingElementStyle="{StaticResource ChildTextEditor}"/>
        <DataGridTextColumn Header="End Y" Binding="{Binding EndY}" Width="80" EditingElementStyle="{StaticResource ChildTextEditor}"/>
       </DataGrid.Columns>
      </DataGrid></Border>
      <WrapPanel Margin="0,8,0,0"><Button Content="Add child" Click="AddChild_Click"/><Button Content="Remove child" Click="RemoveChild_Click"/></WrapPanel>
     </StackPanel>
     <Separator Margin="0,10"/>
     <TextBlock Text="Idle-gap editing" FontSize="18" FontWeight="SemiBold"/>
     <TextBox x:Name="GapBox" Text="100" AutomationProperties.Name="Idle gap in milliseconds"/>
     <WrapPanel><Button Content="Use fixed gaps" Click="FixedGaps_Click"/><Button Content="Cap long gaps" Click="CapGaps_Click"/><Button Content="Remove idle waits" Click="RemoveWaits_Click"/></WrapPanel>
     <TextBlock Text="These commands change only idle waits. Holds and timed groups retain their duration." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
     <TextBlock Text="Idle-gap multiplier · 0–100 (0.5 halves waits)" TextWrapping="Wrap" Margin="0,12,0,0"/>
     <TextBox x:Name="PaceBox" Text="1" AutomationProperties.Name="Idle gap multiplier"/>
     <Button Content="Preview scaled gaps…" Click="ScaleGaps_Click" HorizontalAlignment="Left"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <ScrollViewer x:Name="PlaybackScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel>
   <TextBlock x:Name="SummaryLabel" Margin="0,0,0,8" TextWrapping="Wrap"/>
   <WrapPanel>
    <Button x:Name="RunButton" Content="Run once · 3s" Click="Run_Click"/>
    <Button x:Name="RunConfiguredButton" Content="Run configured loops" Click="RunConfigured_Click"/>
    <Button x:Name="RunSelectedButton" Content="Run selected action · real input" Click="RunSelected_Click"/>
    <Button Content="Stop all" Click="Stop_Click"/>
    <Button Content="Finish this loop" Click="FinishLoop_Click"/>
    <Button x:Name="PausePlaybackButton" Content="Pause playback" Click="PausePlayback_Click"/>
    <Button x:Name="ResumePlaybackButton" Content="Resume playback · 3s" Click="ResumePlayback_Click"/>
    <Button x:Name="PauseCaptureButton" Content="Pause recording" Click="PauseCapture_Click"/>
    <Button x:Name="ResumeCaptureButton" Content="Resume recording · 3s" Click="ResumeCapture_Click"/>
    <Button Content="Retry cleanup" Click="Cleanup_Click"/>
    <Button x:Name="SaveButton" Content="Save changes" Click="Save_Click"/>
    <Button Content="Discard / close" Click="Discard_Click"/>
   </WrapPanel>
   <TextBlock x:Name="MessageLabel" Text="Changes are a draft until you save." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Text="Recording uses physical key positions and the target’s keyboard layout. Ctrl/Shift/Alt chords retain overlap; function-key controls, Windows keys and text actions are excluded. Mouse positions require the recorded client size/DPI. Enable pointer paths for drags. Stop All ends capture." TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0"/>
  </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
