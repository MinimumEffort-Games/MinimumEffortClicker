<Window x:Class="MinimumEffortClicker.App.TimingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Timing view · Minimum Effort Clicker" Width="1100" Height="680" MinWidth="800" MinHeight="460"
 FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="See how actions overlap." FontSize="26" FontWeight="SemiBold"/>
   <TextBlock Text="Read-only preview · no input is sent. Bars share a time axis; overlapping bars run together. Condition markers have unknown duration and shift later actions. The click cap can also extend playback." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,12"/>
   <TextBlock x:Name="Summary" TextWrapping="Wrap"/>
  </StackPanel>
  <DockPanel Grid.Row="1" Margin="0,14">
   <TextBlock Text="Horizontal zoom" VerticalAlignment="Center" Margin="0,0,16,0"/>
   <Slider x:Name="Zoom" Minimum="1" Maximum="20" Value="1" Width="220" HorizontalAlignment="Left" ValueChanged="Zoom_Changed" AutomationProperties.Name="Timing view horizontal zoom"/>
  </DockPanel>
  <Border Grid.Row="2" Padding="7" Background="{DynamicResource Surface}"><DataGrid Grid.Row="2" x:Name="Rows" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
   CanUserSortColumns="False" SelectionMode="Single" EnableRowVirtualization="True" HeadersVisibility="Column" RowHeight="38" FrozenColumnCount="3"
   Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource Border}"
   RowBackground="{DynamicResource Surface}" AlternatingRowBackground="{DynamicResource RaisedSurface}" AutomationProperties.Name="Action timing and overlap">
   <DataGrid.Resources>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardGridHeader}"><Setter Property="Background" Value="{DynamicResource RaisedSurface}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Padding" Value="8"/></Style>
    <Style TargetType="DataGridCell" BasedOn="{StaticResource StandardGridCell}"><Setter Property="Padding" Value="6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
   </DataGrid.Resources>
   <DataGrid.Columns>
    <DataGridTextColumn Header="Action / input" Binding="{Binding Label}" Width="220"/>
    <DataGridTextColumn Header="Start (ms)" Binding="{Binding Start}" Width="130"/>
    <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="150"/>
    <DataGridTemplateColumn Header="Nominal time →" Width="Auto">
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <Canvas Width="{Binding TrackWidth}" Height="24" ToolTip="{Binding Detail}">
       <Border Canvas.Left="{Binding Left}" Width="{Binding BarWidth}" Height="18" Margin="0,3,0,0" Background="{DynamicResource TextSecondary}" CornerRadius="3"/>
      </Canvas>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid></Border>
  <WrapPanel Grid.Row="3" Margin="0,16,0,0">
   <Button Content="Edit selected action" Click="Edit_Click" Padding="14,9" Margin="0,0,12,0"/>
   <Button Content="Close" IsCancel="True" Padding="14,9"/>
  </WrapPanel>
 </Grid>
</Window>
