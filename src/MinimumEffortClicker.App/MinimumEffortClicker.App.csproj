<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(MecWindowsTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF owns DPI initialization through our PerMonitorV2 manifest. Forms is used
         only for NotifyIcon; do not generate a second ApplicationConfiguration. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>../Windows.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/brand/app-icon/app-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Use the built-in notification icon only; keep WPF's control namespaces. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="../../assets/brand/source/logo-owner-transparent.png" Link="Assets/Logo.png" />
    <Resource Include="../../assets/brand/app-icon/app-icon.ico" Link="Assets/App.ico" />
    <!-- Cut by scripts/Build-UiArt.ps1 from assets/ui/source. -->
    <Resource Include="../../assets/ui/generated/**/*.png" LinkBase="Assets/Ui" />
    <ProjectReference Include="../MinimumEffortClicker.Engine/MinimumEffortClicker.Engine.csproj" />
    <ProjectReference Include="../MinimumEffortClicker.Windows/MinimumEffortClicker.Windows.csproj" />
    <ProjectReference Include="../MinimumEffortClicker.Controllers/MinimumEffortClicker.Controllers.csproj" />
    <ProjectReference Include="../MinimumEffortClicker.Storage/MinimumEffortClicker.Storage.csproj" />
    <ProjectReference Include="../MinimumEffortClicker.Steam/MinimumEffortClicker.Steam.csproj" />
  </ItemGroup>
</Project>

