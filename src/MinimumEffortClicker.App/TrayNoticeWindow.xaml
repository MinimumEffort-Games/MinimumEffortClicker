<Window x:Class="MinimumEffortClicker.App.TrayNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ME Clicker will stay active" Icon="Assets/App.ico"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <StackPanel Margin="20">
        <TextBlock Text="ME Clicker will minimize to taskbar and stay active." FontSize="20" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel>
                <TextBlock Text="Click Disable if you do not want this." TextWrapping="Wrap"/>
                <TextBlock Text="(Can be changed in Settings at any time.)"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        <Grid Margin="0,18,0,0">
            <Button Content="DISABLE" Click="Disable_Click" MinWidth="90" HorizontalAlignment="Left"
                    Margin="0" Style="{StaticResource StandardButton}" Background="{DynamicResource StopFill}"
                    BorderBrush="{DynamicResource StopBorder}" Foreground="{DynamicResource ColourButtonText}"/>
        <Button x:Name="OkayButton" Content="OK" Click="Okay_Click" IsDefault="True" IsCancel="True"
                MinWidth="90" HorizontalAlignment="Right" Margin="0"
                Style="{StaticResource StandardButton}" Background="{DynamicResource SuccessFill}"
                BorderBrush="{DynamicResource SuccessBorder}" Foreground="{DynamicResource ColourButtonText}"/>
        </Grid>
    </StackPanel>
</Window>
