<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:app="clr-namespace:MinimumEffortClicker.App">
    <!-- Override the dimensions used by native ScrollViewer templates as well as
         our scrollbar style, so the reserved gutter shrinks with the control. -->
    <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">8</sys:Double>
    <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">8</sys:Double>
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Grip" CornerRadius="3" Background="{DynamicResource RaisedSurface}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="BorderBrush" Value="{DynamicResource FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Grip" Property="BorderBrush" Value="{DynamicResource FocusRing}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="Before" Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb x:Name="Grip" Style="{StaticResource ScrollThumb}" /></Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="After" Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter TargetName="Before" Property="Command" Value="ScrollBar.PageLeftCommand" />
                            <Setter TargetName="After" Property="Command" Value="ScrollBar.PageRightCommand" />
                            <Setter TargetName="Grip" Property="MinHeight" Value="0" />
                            <Setter TargetName="Grip" Property="MinWidth" Value="24" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StandardControl" TargetType="Control">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <Style TargetType="Window" BasedOn="{StaticResource StandardControl}">
        <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <!-- The pre-pixel button treatment, with the newer compact spacing. -->
    <Style x:Key="StandardButton" TargetType="Button" BasedOn="{StaticResource StandardControl}">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Background" Value="{DynamicResource RaisedSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="5" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource StandardButton}" />
    <Style x:Key="StartButton" TargetType="Button" BasedOn="{StaticResource StandardButton}">
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="StandardTextBox" TargetType="TextBox" BasedOn="{StaticResource StandardControl}">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0,4,0,8" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Background" Value="{DynamicResource RaisedSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource StandardTextBox}" />
    <Style x:Key="StandardComboBox" TargetType="ComboBox" BasedOn="{StaticResource StandardControl}">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0,4,0,8" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource StandardComboBox}" />
    <Style TargetType="CheckBox" BasedOn="{StaticResource StandardControl}">
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style TargetType="Expander" BasedOn="{StaticResource StandardControl}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style x:Key="StandardListItem" TargetType="ListBoxItem" BasedOn="{StaticResource StandardControl}">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RaisedSurface}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RaisedSurface}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusRing}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource StandardListItem}" />
    <Style TargetType="ListBox" BasedOn="{StaticResource StandardControl}">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer Focusable="False" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="StandardGridHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardControl}">
        <Setter Property="Background" Value="{DynamicResource RaisedSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Padding" Value="7" />
    </Style>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardGridHeader}" />
    <Style x:Key="StandardGridCell" TargetType="DataGridCell" BasedOn="{StaticResource StandardControl}">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style TargetType="DataGridCell" BasedOn="{StaticResource StandardGridCell}" />
    <Style TargetType="DataGrid" BasedOn="{StaticResource StandardControl}">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="RowBackground" Value="{DynamicResource Surface}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource RaisedSurface}" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="RowHeight" Value="34" />
    </Style>
    <!-- An on/off choice that looks like a standard button. A green outline means it is chosen (on). -->
    <Style x:Key="ChoiceToggle" TargetType="ToggleButton" BasedOn="{StaticResource StandardControl}">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Background" Value="{DynamicResource RaisedSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" CornerRadius="5" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <!-- After the hover trigger, so a chosen toggle stays green under the mouse. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SuccessBorder}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A keycap picture as an on/off choice (Ctrl, Shift, Alt): no button face, only the green outline when chosen. -->
    <Style x:Key="KeycapToggle" TargetType="ToggleButton" BasedOn="{StaticResource ChoiceToggle}">
        <Setter Property="Padding" Value="2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- A keycap picture as a button (the key picker). -->
    <Style x:Key="KeycapButton" TargetType="Button" BasedOn="{StaticResource StandardButton}">
        <Setter Property="Padding" Value="1" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- A row of choices (pictures or words): one is chosen at a time and gets the green outline. -->
    <Style x:Key="ChoiceItem" TargetType="ListBoxItem" BasedOn="{StaticResource StandardControl}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome" CornerRadius="6" Background="{DynamicResource RaisedSurface}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SuccessBorder}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ChoiceList" TargetType="ListBox" BasedOn="{StaticResource StandardControl}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource ChoiceItem}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- The small up and down arrows inside a NumberBox. -->
    <Style x:Key="SpinArrow" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Delay" Value="400" />
        <Setter Property="Interval" Value="60" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="2">
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe Fluent Icons" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Border}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A number field for mouse-only use: the wheel over it and its arrows change the number (see Spin.cs). Each
         field sets its own app:Spin.Step, Minimum and Maximum. -->
    <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource StandardTextBox}">
        <Setter Property="app:Spin.Step" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            <Grid Grid.Column="1" Margin="0,1,1,1">
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <RepeatButton Style="{StaticResource SpinArrow}" Content="&#xE70E;" Command="{x:Static app:Spin.Up}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" ToolTip="Up (Shift: ten steps)" />
                                <RepeatButton Grid.Row="1" Style="{StaticResource SpinArrow}" Content="&#xE70D;" Command="{x:Static app:Spin.Down}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" ToolTip="Down (Shift: ten steps)" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusRing}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusRing}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.56" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A list row's on/off switch: "Active" with a green outline, or "Inactive" with a red one. -->
    <Style x:Key="ActiveToggle" TargetType="ToggleButton" BasedOn="{StaticResource ChoiceToggle}">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="74" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Content" Value="Inactive" />
        <Setter Property="BorderBrush" Value="{DynamicResource StopBorder}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="Active" /></Trigger>
        </Style.Triggers>
    </Style>
    <!-- Repeating / Once under a row's Active button: two small squares spread across the button's width. -->
    <Style x:Key="RepeatChoiceItem" TargetType="ListBoxItem" BasedOn="{StaticResource ChoiceItem}">
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Height" Value="24" />
    </Style>
    <Style x:Key="RepeatChoiceList" TargetType="ListBox" BasedOn="{StaticResource ChoiceList}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource RepeatChoiceItem}" />
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></Setter.Value>
        </Setter>
    </Style>
    <!-- Two on/off choices stacked beside a big button (Loop / Minimize on Start, Record pauses / Minimize on record):
         compact, so together they are as tall as the button. -->
    <Style x:Key="StackedToggle" TargetType="ToggleButton" BasedOn="{StaticResource ChoiceToggle}">
        <Setter Property="Padding" Value="10,1" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>
</ResourceDictionary>
