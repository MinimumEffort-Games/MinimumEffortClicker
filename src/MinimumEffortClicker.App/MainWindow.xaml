                <Grid x:Name="ControllerPage" Visibility="Collapsed">
 <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <Border Grid.Column="1" Width="1" Background="{DynamicResource Border}" HorizontalAlignment="Center"/>
 <ScrollViewer Padding="0,0,16,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <TextBlock Text="Create Controller to Key" Style="{StaticResource Heading}"/>
  <Border x:Name="ControllerBindEditorCard" Style="{StaticResource Card}" BorderBrush="{DynamicResource ActionBorder}" BorderThickness="2"><StackPanel>
   <TextBlock Text="Bind name"/><TextBox x:Name="ControllerBindNameBox" MaxLength="100" AutomationProperties.Name="Bind name"/>
   <TextBlock Text="Key or mouse button to press" Margin="0,8,0,0"/>
   <Button x:Name="ControllerOutputBox" Style="{StaticResource NeedsChoiceButton}" Content="Choose a key or mouse button…" Click="ChooseBindOutput_Click" AutomationProperties.Name="Key or mouse button to press" Margin="0,4,0,12"/>
   <TextBlock Text="Controller binding"/><Button x:Name="ControllerBindButtonBox" Content="Press to choose a button…" Click="CaptureBindButton_Click" AutomationProperties.Name="Controller binding" Margin="0,4,0,0"/>
  </StackPanel></Border>
  <WrapPanel x:Name="ControllerBindEditorTools" Margin="0,6,0,0"><Button x:Name="SaveControllerBindButton" Content="Add Binding" Click="SaveControllerBind_Click" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Style="{StaticResource BlueButton}" AutomationProperties.Name="Save bind"/><Button Content="Clear editor" Click="NewControllerBind_Click" ToolTip="Clear the settings to create another binding. The list is kept."/></WrapPanel>
  <TextBlock x:Name="ControllerBindStatusLabel" Style="{StaticResource OptionalStatus}" TextWrapping="Wrap" Margin="0,6,0,0"/>
 </StackPanel></ScrollViewer>
 <ScrollViewer Grid.Column="2" Padding="0,0,16,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <TextBlock Text="Controller to Key List" Style="{StaticResource Heading}"/>
  <Border x:Name="ControllerBindListCard" Style="{StaticResource Card}" BorderBrush="{DynamicResource ListBorder}" BorderThickness="2"><StackPanel>
   <TextBlock x:Name="ControllerBindEmptyLabel" Text="Create your first bind on the left." Style="{StaticResource Secondary}"/>
   <DataGrid x:Name="ControllerBindList" BorderBrush="{DynamicResource Border}" MinHeight="200" MaxHeight="420" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" ColumnHeaderHeight="34" RowHeight="40" GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource Border}" VerticalGridLinesBrush="{DynamicResource Border}" SelectionChanged="ControllerBindSelection_Changed" AutomationProperties.Name="Controller to Key binds" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardGridHeader}"><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="0,0,1,1"/></Style></DataGrid.ColumnHeaderStyle>
    <DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource StandardGridCell}"><Setter Property="Background" Value="{DynamicResource Surface}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource RaisedSurface}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/></Trigger></Style.Triggers></Style></DataGrid.CellStyle>
    <DataGrid.Columns>
     <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="80"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardGridHeader}"><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Padding" Value="14,7,7,7"/></Style></DataGridTextColumn.HeaderStyle><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
     <DataGridTemplateColumn Header="Controller" Width="96"><DataGridTemplateColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardGridHeader}"><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style></DataGridTemplateColumn.HeaderStyle><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentPresenter Content="{Binding ButtonPicture}" Margin="4,3" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="Presses" Width="96"><DataGridTemplateColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardGridHeader}"><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style></DataGridTemplateColumn.HeaderStyle><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentPresenter Content="{Binding OutputPicture}" Margin="4,3" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="Bind" Width="86"><DataGridTemplateColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardGridHeader}"><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style></DataGridTemplateColumn.HeaderStyle><DataGridTemplateColumn.CellTemplate><DataTemplate>
      <ToggleButton Style="{StaticResource ActiveToggle}" IsChecked="{Binding Active, Mode=OneWay}" Click="ControllerBindActive_Click" ToolTip="Active binds press their key while their controller button is held." AutomationProperties.Name="Bind active" Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
   <Button x:Name="DeleteControllerBindButton" Click="DeleteControllerBind_Click" IsEnabled="False" HorizontalAlignment="Left" Width="34" Height="34" Padding="0" Margin="0,8,0,0" ToolTip="Remove the selected binding" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Remove bind"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE74D;"/></Button>
  </StackPanel></Border>
  <TextBlock x:Name="ControllerBindControllerLabel" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
 </StackPanel></ScrollViewer>
</Grid>
                <Grid x:Name="ScreenshotPage" Visibility="Collapsed"><ScrollViewer Padding="0,0,16,0" VerticalScrollBarVisibility="Auto"><StackPanel>

                    <TextBlock Text="Save a screenshot as a PNG. ME Clicker hides while you capture." Style="{StaticResource Secondary}" Margin="0,0,0,12"/>
                    <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource ActionBorder}"><StackPanel>
                        <TextBlock Text="Capture" FontWeight="SemiBold"/>
                        <ListBox x:Name="ScreenshotModeBox" Style="{StaticResource ChoiceList}" SelectedIndex="1" SelectionChanged="ScreenshotOptions_Changed" HorizontalAlignment="Left" Margin="0,6,0,12" AutomationProperties.Name="Screenshot area"><ListBoxItem Content="Full screen (all monitors)" Padding="10,6"/><ListBoxItem Content="Select an area" Padding="10,6"/></ListBox>
                        <TextBlock Text="Save to folder" FontWeight="SemiBold"/>
                        <DockPanel Margin="0,6,0,8"><Button DockPanel.Dock="Right" Content="Choose folder…" Click="ScreenshotFolder_Click" Height="{Binding ActualHeight, ElementName=ScreenshotFolderBox}" MinHeight="0" Padding="10,0" Margin="6,4,6,8"/><TextBox x:Name="ScreenshotFolderBox" IsReadOnly="True" VerticalContentAlignment="Center" AutomationProperties.Name="Screenshot save folder"/></DockPanel>
                        <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <WrapPanel VerticalAlignment="Bottom"><Button x:Name="TakeScreenshotButton" Content="Take Screenshot" Style="{StaticResource GreenButton}" Click="TakeScreenshot_Click"/><Button Content="Open folder" Click="ScreenshotOpenFolder_Click"/></WrapPanel>
                          <WrapPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <ToggleButton x:Name="ScreenshotClipboardBox" Style="{StaticResource ChoiceToggle}" Content="Copy to clipboard" ToolTip="Each screenshot is also put on the clipboard, ready to paste." Checked="ScreenshotOptions_Changed" Unchecked="ScreenshotOptions_Changed"/>
                            <ToggleButton x:Name="ScreenshotDailyFoldersBox" Style="{StaticResource ChoiceToggle}" Content="Organize into daily folders" ToolTip="Screenshots go into a folder per day inside the save folder." Checked="ScreenshotOptions_Changed" Unchecked="ScreenshotOptions_Changed"/>
                          </WrapPanel>
                        </Grid>

                    </StackPanel></Border>
                    <TextBlock x:Name="ScreenshotStatus" Text="Ready to capture." TextWrapping="Wrap" Margin="0,4,0,8" AutomationProperties.LiveSetting="Polite"/>
                    <Image x:Name="ScreenshotPreview" Stretch="Uniform" MaxHeight="210" MaxWidth="480" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="ScreenshotLastFile" Style="{StaticResource Secondary}" Margin="0,8,0,6"/>
                    <Button x:Name="ScreenshotOpenFileButton" Content="Open last screenshot" Click="ScreenshotOpenFile_Click" IsEnabled="False" HorizontalAlignment="Left"/>
                </StackPanel></ScrollViewer></Grid>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="10" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock x:Name="ReasonLabel" Text="Choose a target to begin." Style="{StaticResource Secondary}" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="PowerBanner" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
