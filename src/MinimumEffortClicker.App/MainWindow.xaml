<Window x:Class="MinimumEffortClicker.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="clr-namespace:MinimumEffortClicker.App" Title="Minimum Effort Clicker" Icon="Assets/App.ico" Width="1180" Height="740" MinWidth="900" MinHeight="600" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="ActionRowText" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Style.Triggers><DataTrigger Binding="{Binding UsesColour}" Value="True"><Setter Property="Foreground" Value="{Binding Foreground}"/></DataTrigger></Style.Triggers></Style>
        <Style TargetType="Button" BasedOn="{StaticResource StandardButton}" />
        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource StandardButton}">
            <Setter Property="Background" Value="{DynamicResource SuccessFill}"/><Setter Property="BorderBrush" Value="{DynamicResource SuccessBorder}"/><Setter Property="Foreground" Value="{DynamicResource ColourButtonText}"/>
        </Style>
        <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource StandardButton}">
            <Setter Property="Background" Value="{DynamicResource ActionFill}"/><Setter Property="BorderBrush" Value="{DynamicResource ActionBorder}"/><Setter Property="Foreground" Value="{DynamicResource ColourButtonText}"/>
        </Style>
        <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource StandardButton}">
            <Setter Property="Background" Value="{DynamicResource StopFill}"/><Setter Property="BorderBrush" Value="{DynamicResource StopBorder}"/><Setter Property="Foreground" Value="{DynamicResource ColourButtonText}"/>
        </Style>
        <!-- A button that still needs a choice: outlined red, not filled, so it is noticed without competing with Stop and Record. -->
        <Style x:Key="NeedsChoiceButton" TargetType="Button" BasedOn="{StaticResource StandardButton}"><Setter Property="BorderBrush" Value="{DynamicResource StopBorder}"/><Setter Property="BorderThickness" Value="2"/></Style>
        <Style x:Key="ChosenButton" TargetType="Button" BasedOn="{StaticResource StandardButton}"><Setter Property="BorderBrush" Value="{DynamicResource SuccessBorder}"/><Setter Property="BorderThickness" Value="2"/></Style>
        <!-- Puts something back to its defaults: outlined red so it is not pressed by accident. -->
        <Style x:Key="ResetButton" TargetType="Button" BasedOn="{StaticResource StandardButton}"><Setter Property="BorderBrush" Value="{DynamicResource StopBorder}"/><Setter Property="BorderThickness" Value="2"/></Style>




        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="OptionalStatus" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><ListBox x:Name="Navigation" SelectedIndex="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" SelectionChanged="Navigation_Changed" AutomationProperties.Name="Navigation tabs" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource StandardListItem}"><Setter Property="Padding" Value="18,8"/><Setter Property="Margin" Value="0,0,6,0"/></Style></ListBox.ItemContainerStyle>
                <ListBoxItem Content="Actions" Tag="QuickPage"/><ListBoxItem Content="Toggles" Tag="TogglePage"/><ListBoxItem Content="Controller to Key" Tag="ControllerPage"/><ListBoxItem Content="Screenshot" Tag="ScreenshotPage"/><ListBoxItem Content="Settings" Tag="SettingsPage"/>
            </ListBox><Button Click="BrandWebsite_Click" ToolTip="Minimum Effort website" AutomationProperties.Name="Minimum Effort website" Background="Transparent" BorderThickness="0" Margin="16,0,0,0" Padding="4"><Border Width="110" Height="34" Background="{DynamicResource TextPrimary}"><Border.OpacityMask><ImageBrush ImageSource="Assets/Logo.png" Viewbox="0,0.24,1,0.42" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform"/></Border.OpacityMask></Border></Button><Button Content="Help" Click="Help_Click" Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Help"/></StackPanel><ToggleButton Grid.Column="1" x:Name="OverlayBox" Style="{StaticResource ChoiceToggle}" Content="Show overlay" IsChecked="True" VerticalAlignment="Center" Checked="Overlay_Changed" Unchecked="Overlay_Changed" Margin="16,0,0,0" ToolTip="The small status window that shows what the clicker is doing."/></Grid>
        </Border>
        <Grid Grid.Row="1" Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="Pages" Grid.Row="0">
                <Grid x:Name="QuickPage">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <Border Grid.Column="1" Grid.RowSpan="3" Width="1" Background="{DynamicResource Border}" HorizontalAlignment="Center"/>
                  <TextBlock Text="Start/Stop" Style="{StaticResource Heading}"/>
                  <TextBlock Grid.Column="2" Text="Action List" Style="{StaticResource Heading}"/>
                  <WrapPanel Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Bottom">
                    <Button x:Name="RunButton" Content="Start F8" Click="Run_Click" Style="{StaticResource GreenButton}" MinWidth="100" Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Start Actions"/>
                    <Button x:Name="PausePlaybackButton" Content="Pause" Click="PausePlayback_Click" Style="{StaticResource BlueButton}" MinWidth="110" Margin="0,0,0,0" AutomationProperties.Name="Pause playback"/>
                    <UniformGrid Rows="2" Margin="12,0,0,0">
                      <ToggleButton x:Name="LoopBox" Style="{StaticResource StackedToggle}" Content="Loop" Checked="Loop_Changed" Unchecked="Loop_Changed" Margin="0,0,0,2"/>
                      <ToggleButton Style="{StaticResource StackedToggle}" Checked="ActionsChoice_Changed" Unchecked="ActionsChoice_Changed" x:Name="MinimizeOnStartBox" Content="Minimize on Start" IsChecked="True" Margin="0,2,0,0" ToolTip="Ticked: Start minimises the clicker when the Click target is Desktop, and brings it back when the run ends. Unticked: the clicker stays up. With a window target, that window still comes to the front."/>
                    </UniformGrid>
                    <Button x:Name="CleanupButton" Content="Release stuck input" Click="Cleanup_Click" Visibility="Collapsed" Style="{StaticResource RedButton}" HorizontalAlignment="Left" ToolTip="Release physical buttons and keys first. This retries only inputs owned by ME Clicker and never starts playback."/>
                  </WrapPanel>
                  <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock x:Name="QuickRecordStatus" Style="{StaticResource OptionalStatus}" FontSize="12" Margin="0,0,0,4"/>
                    <WrapPanel>
                      <Button x:Name="QuickRecordButton" Content="F10 Record/Stop" Click="QuickRecord_Click" Style="{StaticResource RedButton}" Margin="0,0,12,0" Padding="6,7" MinWidth="120"/>
                      <UniformGrid Rows="2">
                        <ToggleButton Style="{StaticResource StackedToggle}" Checked="ActionsChoice_Changed" Unchecked="ActionsChoice_Changed" x:Name="RecordDelaysBox" Content="Record pauses" IsChecked="True" Margin="0,0,0,2" ToolTip="Keep the time between inputs as editable Pause actions."/>
                        <ToggleButton Style="{StaticResource StackedToggle}" Checked="ActionsChoice_Changed" Unchecked="ActionsChoice_Changed" x:Name="MinimizeOnRecordBox" Content="Minimize on record" IsChecked="True" Margin="0,2,0,0" ToolTip="Ticked: the Record button minimises the clicker (F10 too when the Click target is Desktop). Unticked: the clicker stays where it is and just records."/>
                      </UniformGrid>
                    </WrapPanel>
                  </StackPanel>
                  <ScrollViewer Padding="0,0,16,0" Grid.Row="2" x:Name="ActionsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>

                    <TextBlock x:Name="FailureDetailLabel" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" Visibility="Collapsed"/>
                    <TextBlock x:Name="PickTargetHeading" Text="Pick a target" Style="{StaticResource Heading}"/><StackPanel x:Name="QuickFields">
                      <Border x:Name="TargetCard" Style="{StaticResource Card}" BorderBrush="{DynamicResource StopBorder}" BorderThickness="2"><StackPanel><TextBlock Text="Click target" FontWeight="SemiBold"/><ComboBox x:Name="TargetLabel" Text="Desktop" DisplayMemberPath="Title" IsEditable="False" IsTextSearchEnabled="False" DropDownOpened="ClickTargets_Opened" SelectionChanged="ClickTarget_Changed" AutomationProperties.Name="Click target" ToolTip="Desktop uses screen coordinates. Open this list to refresh available windows."/><TextBlock Text="If no app is selected, physical desktop coordinates are used." Style="{StaticResource Secondary}" FontSize="12" Margin="0,6,0,0"/></StackPanel></Border>
                      <TextBlock Text="Create an action" Style="{StaticResource Heading}"/>
                      <Border x:Name="CreateActionCard" Style="{StaticResource Card}" BorderBrush="{DynamicResource ActionBorder}" BorderThickness="2"><StackPanel>
                        <TextBlock Text="Action" FontWeight="SemiBold"/>
                        <ListBox x:Name="ModeBox" Style="{StaticResource ChoiceList}" SelectedIndex="-1" SelectionChanged="ActionType_Changed" AutomationProperties.Name="Action" Margin="0,4,0,0" RenderOptions.BitmapScalingMode="HighQuality">
                          <ListBoxItem ToolTip="Click" AutomationProperties.Name="Click"><Image Source="Assets/Ui/actions/click.png" Width="34" Height="34"/></ListBoxItem>
                          <ListBoxItem ToolTip="Key Press" AutomationProperties.Name="Key Press"><Image Source="Assets/Ui/actions/key-press.png" Width="34" Height="34"/></ListBoxItem>
                          <ListBoxItem ToolTip="Pause" AutomationProperties.Name="Pause"><Image Source="Assets/Ui/actions/pause.png" Width="34" Height="34"/></ListBoxItem>
                          <ListBoxItem ToolTip="Wait Until" AutomationProperties.Name="Wait Until"><Image Source="Assets/Ui/actions/wait-until.png" Width="34" Height="34"/></ListBoxItem>
                          <ListBoxItem ToolTip="Take fullscreen screenshot" AutomationProperties.Name="Take fullscreen screenshot"><Image Source="Assets/Ui/actions/fullscreen-screenshot.png" Width="34" Height="34"/></ListBoxItem>
                          <ListBoxItem ToolTip="Scroll" AutomationProperties.Name="Scroll"><Image Source="Assets/Ui/actions/scroll.png" Width="34" Height="34"/></ListBoxItem>
                        </ListBox>
                        <TextBlock x:Name="ActionHint" Text="Choose an action to see its settings." Style="{StaticResource Secondary}" Margin="0,4,0,8"/>
                        <StackPanel x:Name="ActionFields" Visibility="Collapsed">
                          <StackPanel x:Name="MouseFields" Visibility="Collapsed">
                            <TextBlock Text="Mouse Button" FontWeight="SemiBold"/>
                            <app:MouseButtonPicker x:Name="ButtonPicker" Height="170" HorizontalAlignment="Left" Margin="0,4,0,8"/>
                            <TextBlock Text="Click Type" FontWeight="SemiBold"/>
                            <ListBox x:Name="ClickKindBox" Style="{StaticResource ChoiceList}" SelectedIndex="0" SelectionChanged="ClickKind_Changed" AutomationProperties.Name="Click type" Margin="0,4,0,8">
                              <ListBoxItem Content="Single Click" Padding="10,6"/><ListBoxItem Content="Double Click" Padding="10,6"/><ListBoxItem Content="Hold" Padding="10,6" ToolTip="Presses, keeps the button down for the hold duration, then lets go."/>
                            </ListBox>
                          </StackPanel>
                          <StackPanel x:Name="ScrollFields" Visibility="Collapsed">
                            <TextBlock Text="Direction" FontWeight="SemiBold"/>
                            <!-- Item order is the direction's number (Up, Down, Left, Right); the grid places them like arrow keys. -->
                            <ListBox x:Name="ScrollDirectionBox" Style="{StaticResource ChoiceList}" SelectedIndex="1" AutomationProperties.Name="Scroll direction" Margin="0,4,0,8" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality">
                              <ListBox.ItemsPanel><ItemsPanelTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions></Grid></ItemsPanelTemplate></ListBox.ItemsPanel>
                              <ListBoxItem Grid.Column="1" Padding="2" Margin="2" ToolTip="Up" AutomationProperties.Name="Up"><Image Source="Assets/Ui/keys/up.png" Width="34" Height="34"/></ListBoxItem>
                              <ListBoxItem Grid.Column="1" Grid.Row="1" Padding="2" Margin="2" ToolTip="Down" AutomationProperties.Name="Down"><Image Source="Assets/Ui/keys/down.png" Width="34" Height="34"/></ListBoxItem>
                              <ListBoxItem Grid.Row="1" Padding="2" Margin="2" ToolTip="Left" AutomationProperties.Name="Left"><Image Source="Assets/Ui/keys/left.png" Width="34" Height="34"/></ListBoxItem>
                              <ListBoxItem Grid.Column="2" Grid.Row="1" Padding="2" Margin="2" ToolTip="Right" AutomationProperties.Name="Right"><Image Source="Assets/Ui/keys/right.png" Width="34" Height="34"/></ListBoxItem>
                            </ListBox>
                            <TextBlock Text="Notches (1–100)"/><TextBox x:Name="ScrollNotchesBox" Style="{StaticResource NumberBox}" app:Spin.Step="1" app:Spin.Minimum="1" app:Spin.Maximum="100" Text="3" AutomationProperties.Name="Scroll notches" ToolTip="One notch is one click of the mouse wheel."/>
                            <TextBlock Text="Time between notches (ms)"/><TextBox x:Name="ScrollGapBox" Style="{StaticResource NumberBox}" app:Spin.Step="10" app:Spin.Minimum="0" app:Spin.Maximum="60000" Text="30" AutomationProperties.Name="Time between scroll notches"/>
                          </StackPanel>
                          <StackPanel x:Name="LocationFields" Visibility="Collapsed">
                            <TextBlock x:Name="ClickLocationHeader" Text="Click Location" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="ScrollLocationHeader" Text="Scroll Location" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <WrapPanel>
                              <Button x:Name="CursorLocationButton" Margin="0,0,6,0" Content="Cursor location" Click="CursorLocation_Click" Style="{StaticResource ChosenButton}"/>
                              <Button x:Name="SetLocationButton" Content="Set Location…" Click="PickQuickPoint_Click"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                              <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox x:Name="QuickXBox" Style="{StaticResource NumberBox}" app:Spin.Step="1" app:Spin.Minimum="-100000" app:Spin.Maximum="100000" Width="100" VerticalContentAlignment="Center" AutomationProperties.Name="Click X coordinate" ToolTip="Desktop pixels, or pixels from the selected window's top-left client corner."/>
                              <TextBlock Text="Y" VerticalAlignment="Center" Margin="4,0,4,0"/><TextBox x:Name="QuickYBox" Style="{StaticResource NumberBox}" app:Spin.Step="1" app:Spin.Minimum="-100000" app:Spin.Maximum="100000" Width="100" VerticalContentAlignment="Center" AutomationProperties.Name="Click Y coordinate"/>
                              <Button x:Name="PingLocationButton" Width="100" Height="{Binding ActualHeight, ElementName=QuickXBox}" MinHeight="0" Padding="4,0" Margin="8,4,0,8" VerticalAlignment="Top" Content="Ping location" Click="PingLocation_Click"/>
                            </WrapPanel>
                          </StackPanel>
<StackPanel x:Name="MotionFields" Visibility="Collapsed"><ToggleButton x:Name="VaryPositionBox" Style="{StaticResource ChoiceToggle}" Content="Randomize click location offset" HorizontalAlignment="Left" Margin="0,6,0,6"/><TextBlock Text="Maximum offset (pixels, 0–25)"/><TextBox x:Name="PositionOffsetBox" Style="{StaticResource NumberBox}" app:Spin.Step="1" app:Spin.Minimum="0" app:Spin.Maximum="25" Text="3" AutomationProperties.Name="Click position variation"/></StackPanel>
                          <StackPanel x:Name="KeyFields" Visibility="Collapsed">
                            <TextBlock Text="Key"/>
                            <WrapPanel Margin="0,4,0,8" RenderOptions.BitmapScalingMode="HighQuality">
                              <Button x:Name="KeyBox" Click="ChooseKey_Click" Padding="6,3" Margin="0,0,8,0" ToolTip="Choose the key on a keyboard." AutomationProperties.Name="Key"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,8" RenderOptions.BitmapScalingMode="HighQuality">
                              <ToggleButton x:Name="CtrlBox" Style="{StaticResource KeycapToggle}" ToolTip="Ctrl: held with the key" AutomationProperties.Name="Ctrl"><Image Source="Assets/Ui/keys/left-ctrl.png" Width="36" Height="36"/></ToggleButton>
                              <ToggleButton x:Name="ShiftBox" Style="{StaticResource KeycapToggle}" ToolTip="Shift: held with the key" AutomationProperties.Name="Shift"><Image Source="Assets/Ui/keys/left-shift.png" Width="36" Height="36"/></ToggleButton>
                              <ToggleButton x:Name="AltBox" Style="{StaticResource KeycapToggle}" ToolTip="Alt: held with the key" AutomationProperties.Name="Alt"><Image Source="Assets/Ui/keys/left-alt.png" Width="36" Height="36"/></ToggleButton>
                            </WrapPanel>
                          </StackPanel>
                          <StackPanel x:Name="PressFields" Visibility="Collapsed"><TextBlock x:Name="PressLabel" Text="Press duration (ms)"/><TextBox x:Name="PressBox" Style="{StaticResource NumberBox}" app:Spin.Step="10" app:Spin.Minimum="0" app:Spin.Maximum="3600000" Text="20" AutomationProperties.Name="Press duration in milliseconds"/></StackPanel>
                          <StackPanel x:Name="DoubleFields" Visibility="Collapsed"><TextBlock Text="Gap between the two clicks (ms)"/><TextBox x:Name="DoubleGapBox" Style="{StaticResource NumberBox}" app:Spin.Step="10" app:Spin.Minimum="0" app:Spin.Maximum="60000" Text="80" AutomationProperties.Name="Double click gap"/></StackPanel>
                          <StackPanel x:Name="AfterFields" Visibility="Collapsed"><TextBlock x:Name="AfterLabel" Text="Pause after this action (ms)"/><TextBox x:Name="AfterBox" Style="{StaticResource NumberBox}" app:Spin.Step="10" app:Spin.Minimum="0" app:Spin.Maximum="3600000" Text="20" AutomationProperties.Name="Pause after action"/></StackPanel>
                          <StackPanel x:Name="ScreenshotActionFields" Visibility="Collapsed">
                            <TextBlock Text="Pause after saving (ms)"/><TextBox x:Name="ScreenshotPauseBox" Style="{StaticResource NumberBox}" app:Spin.Step="100" app:Spin.Minimum="1000" app:Spin.Maximum="3600000" Text="1000" AutomationProperties.Name="Pause after saving screenshot"/>
                            <TextBlock Text="Minimum 1,000 ms. Each image finishes saving before this pause begins. Uses the folder and clipboard option in Screenshot." Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
                          </StackPanel>
                          <StackPanel x:Name="PauseFields" Visibility="Collapsed"><TextBlock Text="Pause for"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="PauseDurationBox" Style="{StaticResource NumberBox}" app:Spin.Step="1" app:Spin.Minimum="0" app:Spin.Maximum="3600000" Text="1" AutomationProperties.Name="Pause duration"/><ListBox Grid.Column="1" x:Name="PauseUnitBox" Style="{StaticResource FillChoiceList}" SelectedIndex="1" Height="{Binding ActualHeight, ElementName=PauseDurationBox}" Margin="8,4,-4,8" AutomationProperties.Name="Pause unit"><ListBoxItem Content="ms" Padding="10,6" ToolTip="Milliseconds"/><ListBoxItem Content="Seconds" Padding="10,6"/></ListBox></Grid></StackPanel>
                          <StackPanel x:Name="ConditionFields" Visibility="Collapsed"><TextBlock Text="Wait until" FontWeight="SemiBold"/>
                            <ListBox x:Name="ConditionKindBox" Style="{StaticResource ChoiceList}" SelectedIndex="0" SelectionChanged="ConditionKind_Changed" AutomationProperties.Name="Wait until" Margin="0,4,0,8">
                              <ListBoxItem Content="A Colour appears" Padding="10,6"/><ListBoxItem Content="A Colour disappears" Padding="10,6"/>
                            </ListBox>
                            <TextBlock Text="Area" FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,4,0,0"><Button x:Name="SelectAreaButton" Style="{StaticResource NeedsChoiceButton}" Content="Select area… (drag on a snapshot)" Click="SelectConditionArea_Click" ToolTip="Takes a picture of the Click target (or the monitors on Desktop) and lets you drag the area to watch. The colour is taken from its top-left pixel." AutomationProperties.Name="Select area"/><Button x:Name="PingScanAreaButton" IsEnabled="False" Content="Ping scan area" Click="PingScanArea_Click" ToolTip="Outlines the area this wait watches on the target, three times." AutomationProperties.Name="Ping scan area"/></WrapPanel>
                            <TextBlock Text="RGB colour · six hexadecimal digits" Margin="0,6,0,0"/><TextBox x:Name="ConditionRgbBox" MaxLength="7" TextChanged="ConditionField_Changed" AutomationProperties.Name="RGB colour"/>
                            <Button x:Name="EyedropperButton" Content="Eyedropper · pick colour…" HorizontalAlignment="Left" Margin="0,6,0,6" Click="ConditionEyedropper_Click" ToolTip="Click one pixel on a picture of the target to take its colour. The area is kept." AutomationProperties.Name="Eyedropper pick colour"/>
                            <TextBlock Text="Colour Preview" FontWeight="SemiBold"/>
                            <Border x:Name="ConditionColourPreview" MinHeight="34" Margin="0,4,0,6" Padding="8,5" BorderThickness="1" BorderBrush="{DynamicResource ListBorder}" AutomationProperties.Name="Colour preview">
                              <TextBlock x:Name="ConditionLabel" Text="Select the area to scan and what to look for." TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Border>
                          </StackPanel>
                          <StackPanel x:Name="ComplexFields" Visibility="Collapsed">
                            <TextBlock Text="Recorded inputs — timing in milliseconds" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="Each row is one held input. Offset is when it starts within this action." Style="{StaticResource Secondary}"/>
                            <DataGrid x:Name="QuickChildrenGrid" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="120" MaxHeight="220" HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto">
                              <DataGrid.Columns><DataGridComboBoxColumn x:Name="ChildInputColumn" Header="Input" SelectedItemBinding="{Binding Input}" Width="100"/><DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="65"/><DataGridTextColumn Header="Hold" Binding="{Binding Duration}" Width="65"/><DataGridTextColumn Header="X" Binding="{Binding X}" Width="55"/><DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="55"/></DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Total action duration (ms)"/><TextBox x:Name="ComplexDurationBox" Style="{StaticResource NumberBox}" app:Spin.Step="10" app:Spin.Minimum="0" app:Spin.Maximum="3600000" AutomationProperties.Name="Total action duration"/>
                          </StackPanel>
                          <StackPanel Margin="0,8,0,0">
                            <StackPanel x:Name="RandomFields" Visibility="Collapsed">
                              <ToggleButton x:Name="RandomTimingBox" Style="{StaticResource ChoiceToggle}" HorizontalAlignment="Left" Margin="0,0,0,6" Content="Randomize press and pause timing" ToolTip="Choose a fresh duration between each minimum and maximum on every execution." Checked="TimingOptions_Changed" Unchecked="TimingOptions_Changed"/>
                              <StackPanel x:Name="RandomRanges" Visibility="Collapsed">
                                <TextBlock Text="Use the values above as minimums." Style="{StaticResource Secondary}"/>
                                <StackPanel x:Name="MaximumPressFields"><TextBlock Text="Maximum press duration (ms)"/><TextBox x:Name="MaxPressBox" Style="{StaticResource NumberBox}" app:Spin.Step="10" app:Spin.Minimum="0" app:Spin.Maximum="3600000" Text="40" AutomationProperties.Name="Maximum press duration"/></StackPanel>
                                <TextBlock x:Name="MaxAfterLabel" Text="Maximum pause after (ms)"/><TextBox x:Name="MaxAfterBox" Style="{StaticResource NumberBox}" app:Spin.Step="10" app:Spin.Minimum="0" app:Spin.Maximum="3600000" Text="80" AutomationProperties.Name="Maximum pause or interval"/>
                              </StackPanel>
                            </StackPanel><TextBlock Text="Name (optional)"/><TextBox x:Name="ActionNameBox" MaxLength="100" AutomationProperties.Name="Action name"/>
                            <StackPanel x:Name="ConditionAdvancedFields" Visibility="Collapsed">
                              <Expander Header="Advanced: coordinates, scan speed and matching" Margin="0,8,0,8" Foreground="{DynamicResource TextPrimary}">
                                <StackPanel Margin="0,4,0,0">
                                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="X"/><TextBox x:Name="ConditionXBox" Style="{StaticResource NumberBox}" app:Spin.Step="1" app:Spin.Minimum="-100000" app:Spin.Maximum="100000" TextChanged="ConditionField_Changed" AutomationProperties.Name="Area X"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Y"/><TextBox x:Name="ConditionYBox" Style="{StaticResource NumberBox}" app:Spin.Step="1" app:Spin.Minimum="-100000" app:Spin.Maximum="100000" TextChanged="ConditionField_Changed" AutomationProperties.Name="Area Y"/></StackPanel>
                                  </Grid>
                                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Width · 1–256 pixels" TextWrapping="Wrap"/><TextBox x:Name="ConditionWidthBox" Style="{StaticResource NumberBox}" app:Spin.Step="1" app:Spin.Minimum="1" app:Spin.Maximum="256" TextChanged="ConditionField_Changed" AutomationProperties.Name="Area width"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Height · 1–256 pixels" TextWrapping="Wrap"/><TextBox x:Name="ConditionHeightBox" Style="{StaticResource NumberBox}" app:Spin.Step="1" app:Spin.Minimum="1" app:Spin.Maximum="256" TextChanged="ConditionField_Changed" AutomationProperties.Name="Area height"/></StackPanel>
                                  </Grid>
                                  <TextBlock Text="Per-channel tolerance · 0–255"/><TextBox x:Name="ConditionToleranceBox" Style="{StaticResource NumberBox}" app:Spin.Step="1" app:Spin.Minimum="0" app:Spin.Maximum="255" Text="8" TextChanged="ConditionField_Changed" AutomationProperties.Name="Per-channel tolerance"/>
                                  <TextBlock Text="Scan interval · milliseconds (100–5,000)"/><TextBox x:Name="QuickScanIntervalBox" Style="{StaticResource NumberBox}" app:Spin.Step="10" app:Spin.Minimum="100" app:Spin.Maximum="5000" Text="500" TextChanged="ConditionField_Changed" AutomationProperties.Name="Scan interval in milliseconds"/>
                                  <TextBlock Text="Default: 500 ms (twice a second). A smaller area uses less processing." Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
                                  <TextBlock Text="Consecutive fresh matching samples · 1–10"/><TextBox x:Name="ConditionStableBox" Style="{StaticResource NumberBox}" app:Spin.Step="1" app:Spin.Minimum="1" app:Spin.Maximum="10" Text="1" TextChanged="ConditionField_Changed" AutomationProperties.Name="Consecutive matching samples"/>
                                </StackPanel>
                              </Expander>
