<Window x:Class="MinimumEffortClicker.TestTarget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minimum Effort Clicker — TestTarget" Width="1000" Height="760" MinWidth="620" MinHeight="560"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        Activated="Window_FocusChanged" Deactivated="Window_FocusChanged"
        PreviewMouseUp="Window_MouseUp">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="TESTTARGET · MANUAL INPUT ONLY · NEUTRAL TEST SHELL" FontSize="12" />
            <TextBlock Text="A safe place to test." FontSize="30" Margin="0,8" />
            <TextBlock TextWrapping="Wrap" Text="Click or tab into the area below, then press keys or mouse buttons. Only input received here is shown. No input is generated, saved or sent over the network." />
            <TextBlock Text="{Binding FocusStatus}" FontWeight="SemiBold" Margin="0,12" />
        </StackPanel>
        <Border x:Name="InputArea" Grid.Row="1" Focusable="True" MinHeight="170" Padding="20"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                TextElement.Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                AutomationProperties.Name="Manual input test area" KeyboardNavigation.TabIndex="0"
                GotKeyboardFocus="Area_FocusChanged" LostKeyboardFocus="Area_FocusChanged"
                PreviewMouseDown="Area_MouseDown" MouseLeave="Area_MouseLeave"
                PreviewKeyDown="Area_KeyDown" PreviewKeyUp="Area_KeyUp" PreviewMouseWheel="Area_MouseWheel" TextInput="Area_TextInput">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderThickness" Value="2" />
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderThickness" Value="4" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid IsHitTestVisible="False">
            <StackPanel>
                <TextBlock Text="INPUT TEST AREA" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Click here to focus · Tab leaves this area" Margin="0,8" />
                <TextBlock Text="{Binding ClickCount, StringFormat='Completed clicks: {0}'}" FontSize="26" />
                <TextBlock Text="{Binding PointerMoves, StringFormat='Pointer moves: {0}'}"/><TextBlock Text="{Binding DragMoves, StringFormat='Moves while held: {0}'}"/><TextBlock Text="{Binding PointerPosition, StringFormat='Pointer position: {0}'}"/><TextBlock Text="{Binding ClickSummary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock x:Name="ReceivedText" TextWrapping="Wrap" Text="Text received here (latest 256 units, memory only):"/>
            </StackPanel>
            <Border x:Name="CapturePatch" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#2468AC" Visibility="Collapsed"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,12">
            <TextBlock Text="{Binding KeysDown, StringFormat='Keys down: {0}'}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ButtonsDown, StringFormat='Buttons down: {0}'}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding HorizontalWheelDelta, StringFormat='Horizontal wheel delta: {0}'}"/>
            <TextBlock Text="Indicators show observed state only; focus loss clears them. A click needs down and up inside the area." TextWrapping="Wrap" Margin="0,6" />
            <DockPanel Margin="0,8,0,0">
                <Button Content="_Clear session" Click="Clear_Click" DockPanel.Dock="Right" Padding="16,6" />
                <TextBlock Text="Latest 200 events · Display up to 10 Hz · Receipt counted immediately" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </StackPanel>
        <ListBox Grid.Row="3" ItemsSource="{Binding VisibleEvents}" FontFamily="Consolas" FontSize="12"
                 AutomationProperties.Name="Bounded input event log"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />
    </Grid>
</Window>
